---
// src/components/AboutProjectImage.astro
---

<section class="project-image-section">
  <!-- The content is purely visual (a large background image with a gradient overlay) -->
</section>

<style>
  .project-image-section {
    width: 100%;
    height: 864px;
    background: linear-gradient(180deg, rgba(18, 18, 18, 0) 0%, rgba(18, 18, 18, 0.33) 100%),
                url('/section-image.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  /* Responsive Adjustments */
  @media (max-width: 1024px) {
    .project-image-section {
      height: 600px;
    }
  }

  @media (max-width: 768px) {
    .project-image-section {
      height: 400px;
    }
  }
</style>
