---
// src/components/AvonceWay.astro
---

<section id="avonce-way" class="avonce-way">
  <div class="header-section">
    <h2 class="heading">The Avonce Way</h2>
    <p class="text">
      A Disciplined Approach From Preconstruction to Close-Out. With discipline in our planning and pride in our craft, we are committed to delivering safe, efficient, and high-quality construction for our partners.
    </p>
  </div>

  <div class="slider-container">
    <!-- Left Tab (Previous) -->
    <button class="slider-tab prev-tab" id="prevBtn" aria-label="Previous Phase">
      <span class="tab-text" id="prevTabText">Lesson Learned</span>
    </button>

    <!-- Center Slider Viewport -->
    <div class="slider-viewport" id="sliderViewport">
      <!-- Gradient overlay inside viewport -->
      <div class="gradient-overlay"></div>
      
      <!-- Content Overlay -->
      <div class="slider-content">
        <h4 class="phase-label" id="slidePhase">Phase 1</h4>
        <h3 class="slide-title" id="slideTitle">Project budget preparation</h3>
        <p class="slide-desc" id="slideDesc">
          The process begins with a thorough review of project information to establish a clear, accurate, and well-defined budget. Drawings, specifications, and scope requirements are carefully analyzed with a focus on constructability, sequencing, and project intent. This early evaluation creates a solid foundation, aligns expectations, and reduces risk before the project moves forward.
        </p>
      </div>

      <!-- Navigation Indicators -->
      <div class="navigation-indicators" id="navIndicators">
        <!-- Generated via JS -->
      </div>
    </div>

    <!-- Right Tab (Next) -->
    <button class="slider-tab next-tab" id="nextBtn" aria-label="Next Phase">
      <span class="tab-text" id="nextTabText">Pre-construction planning</span>
    </button>
  </div>
</section>

<style>
  .avonce-way {
    width: 100%;
    background: #FCFCFC;
    padding: 148px 20px 100px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 64px;
    overflow: hidden;
    transform: scale(0.96);
    transform-origin: center top;
    will-change: transform;
  }

  .header-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 657px;
    text-align: center;
    opacity: 0;
    transform: translateY(4vh);
    will-change: opacity, transform;
  }

  .heading {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 48px;
    line-height: 1.3;
    letter-spacing: -0.03em;
    color: #1E1E1E;
    margin: 0;
  }

  .text {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.7;
    letter-spacing: -0.02em;
    color: #1B1B1B;
    margin: 0;
  }

  /* Slider Structure */
  .slider-container {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 1296px;
    height: 600px;
    opacity: 0;
    transform: translateY(4vh);
    will-change: opacity, transform;
  }

  .slider-tab {
    width: 93px;
    height: 555px;
    display: flex;
    justify-content: center;
    align-items: center;
    border: none;
    cursor: pointer;
    transition: opacity 0.3s ease;
    padding: 0;
  }

  .slider-tab:hover {
    opacity: 0.9;
  }

  .prev-tab {
    background: #1B1B1B;
  }

  .next-tab {
    background: #E6A523;
  }

  .tab-text {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 24px;
    line-height: 1.4;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .prev-tab .tab-text {
    color: #F5F4F4;
    transform: rotate(180deg);
    writing-mode: vertical-rl;
  }

  .next-tab .tab-text {
    color: #1B1B1B;
    transform: rotate(180deg);
    writing-mode: vertical-rl;
  }

  .slider-viewport {
    flex: 1;
    height: 100%;
    position: relative;
    background-size: cover;
    background-position: center;
    transition: background-image 0.5s ease-in-out;
    background-image: url('/slider/slider_0.png'); /* Default */
  }

  .gradient-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(18, 18, 18, 0) -23.9%, #121212 100%),
                linear-gradient(0deg, rgba(18, 18, 18, 0.2), rgba(18, 18, 18, 0.2));
  }

  .slider-content {
    position: absolute;
    bottom: 80px;
    left: 46px;
    right: 46px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 2;
    transition: opacity 0.4s ease;
  }

  .phase-label {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 24px;
    line-height: 1.4;
    color: #E6A523;
    margin: 0;
  }

  .slide-title {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 32px;
    line-height: 1.4;
    color: #F5F4F4;
    margin: 0 0 4px 0;
  }

  .slide-desc {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.7;
    color: #F5F4F4;
    margin: 0;
    max-width: 1018px;
  }

  .navigation-indicators {
    position: absolute;
    bottom: 26px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 16px;
    z-index: 2;
  }

  :global(.nav-dot) {
    width: 79px;
    height: 6px;
    background: #D9D9D9;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  :global(.nav-dot.active) {
    background: #E6A523;
  }

  /* Responsive Adjustments */
  @media (max-width: 1024px) {
    .slider-container {
      height: 844px; /* Taller on mobile to fit content */
      flex-direction: column;
    }

    .slider-tab {
      display: none; /* Hide side tabs on small screens, rely on bottom navigation */
    }

    .slider-viewport {
      width: 100%;
      height: 100%;
    }

    .slider-content {
      bottom: 80px;
      left: 16px;
      right: 16px;
    }
  }

  @media (max-width: 768px) {
    .avonce-way {
      padding: 80px 0 60px; /* Reduce horizontal padding to let slider take full width */
    }

    .header-section {
      padding: 0 16px; /* Keep text padded */
    }

    .heading {
      font-size: 36px;
    }

    .phase-label {
      font-size: 18px;
    }

    .slide-title {
      font-size: 28px;
    }

    .slide-desc {
      font-size: 18px;
    }

    .navigation-indicators {
      bottom: 36px;
      gap: 6.66px;
    }

    :global(.nav-dot) {
      width: 65.76px;
      height: 5px;
    }
  }
</style>

<script>
  // Slider Logic
  const slides = [
    {
      phase: "Phase 1",
      title: "Project budget preparation",
      desc: "The process begins with a thorough review of project information to establish a clear, accurate, and well-defined budget. Drawings, specifications, and scope requirements are carefully analyzed with a focus on constructability, sequencing, and project intent. This early evaluation creates a solid foundation, aligns expectations, and reduces risk before the project moves forward.",
      image: "/slider/slider_0.png"
    },
    {
      phase: "Phase 2",
      title: "Pre-construction planning",
      desc: "Detailed scheduling and coordination take place. We secure necessary permits, finalize vendor agreements, and map out the logistics to ensure a seamless transition to the construction phase. Our proactive approach guarantees that resources are allocated efficiently.",
      image: "/slider/slider_1.png"
    },
    {
      phase: "Phase 3",
      title: "Construction & Execution",
      desc: "Our skilled field crews take over, bringing the plans to life. Constant monitoring of safety, quality, and progress ensures that the project stays on track. Regular communication with partners keeps everyone informed and aligned throughout the build.",
      image: "/slider/slider_2.png"
    },
    {
      phase: "Phase 4",
      title: "Close-Out & Review",
      desc: "We perform a comprehensive final inspection, ensuring all punch list items are resolved. The close-out phase also includes a 'Lesson Learned' review to identify successes and areas for improvement, continuously refining our processes for future projects.",
      image: "/slider/slider_3.png"
    }
  ];

  let currentIndex = 0;

  // DOM Elements
  const viewport = document.getElementById('sliderViewport');
  const contentEl = document.querySelector('.slider-content');
  const phaseEl = document.getElementById('slidePhase');
  const titleEl = document.getElementById('slideTitle');
  const descEl = document.getElementById('slideDesc');
  const prevTabText = document.getElementById('prevTabText');
  const nextTabText = document.getElementById('nextTabText');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const navContainer = document.getElementById('navIndicators');

  function initSlider() {
    // Generate nav dots
    slides.forEach((_, index) => {
      const dot = document.createElement('div');
      dot.className = `nav-dot ${index === currentIndex ? 'active' : ''}`;
      dot.addEventListener('click', () => goToSlide(index));
      navContainer.appendChild(dot);
    });
    updateDOM();
  }

  function updateDOM() {
    const slide = slides[currentIndex];
    
    // Calculate prev and next indices
    const prevIndex = currentIndex === 0 ? slides.length - 1 : currentIndex - 1;
    const nextIndex = currentIndex === slides.length - 1 ? 0 : currentIndex + 1;

    // Fade out content
    contentEl.style.opacity = '0';
    
    setTimeout(() => {
      // Update data
      viewport.style.backgroundImage = `url('${slide.image}')`;
      phaseEl.textContent = slide.phase;
      titleEl.textContent = slide.title;
      descEl.textContent = slide.desc;
      
      prevTabText.textContent = slides[prevIndex].title;
      nextTabText.textContent = slides[nextIndex].title;

      // Update dots
      const dots = navContainer.children;
      for(let i=0; i<dots.length; i++) {
        dots[i].className = `nav-dot ${i === currentIndex ? 'active' : ''}`;
      }

      // Fade in
      contentEl.style.opacity = '1';
    }, 300); // Wait for fade out
  }

  function goToSlide(index) {
    if(index === currentIndex) return;
    currentIndex = index;
    updateDOM();
  }

  // Event Listeners
  prevBtn.addEventListener('click', () => {
    goToSlide(currentIndex === 0 ? slides.length - 1 : currentIndex - 1);
  });

  nextBtn.addEventListener('click', () => {
    goToSlide(currentIndex === slides.length - 1 ? 0 : currentIndex + 1);
  });

  // Initialize
  initSlider();

  // Scroll Animation Logic
  const avonceWaySection = document.querySelector('.avonce-way') as HTMLElement;
  const headerSection = document.querySelector('.avonce-way .header-section') as HTMLElement;
  const sliderContainer = document.querySelector('.avonce-way .slider-container') as HTMLElement;

  if (avonceWaySection && headerSection && sliderContainer) {
    let ticking = false;

    function updateAnimation() {
      const rect = avonceWaySection.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      
      let progress = 1 - (rect.top / windowHeight);
      progress = Math.max(0, Math.min(progress, 1));
      
      if (progress >= 1) {
        avonceWaySection.style.transform = 'none';
      } else {
        const scale = 0.96 + (progress * 0.04);
        avonceWaySection.style.transform = `scale(${scale})`;
      }
      
      const opacity = progress; 
      const yOffset = (1 - progress) * 4;
      
      headerSection.style.opacity = opacity.toString();
      headerSection.style.transform = `translateY(${yOffset}vh)`;
      
      // Delay slider container animation slightly for a staggered effect
      const sliderProgress = Math.max(0, Math.min(progress * 1.2 - 0.2, 1));
      sliderContainer.style.opacity = sliderProgress.toString();
      sliderContainer.style.transform = `translateY(${(1 - sliderProgress) * 4}vh)`;
      
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateAnimation);
        ticking = true;
      }
    }, { passive: true });

    updateAnimation();
  }
</script>
