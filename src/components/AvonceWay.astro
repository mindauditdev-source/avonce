---
// src/components/AvonceWay.astro
---

<section id="avonce-way" class="avonce-way">
  <div class="header-section" data-reveal>
    <h2 class="heading">The Avonce Way</h2>
    <p class="text">
      A Disciplined Approach From Preconstruction to Close-Out. With discipline in our planning and pride in our craft, we are committed to delivering safe, efficient, and high-quality construction for our partners.
    </p>
  </div>

  <div class="slider-container" data-reveal data-reveal-delay="200">

    <button class="slider-tab prev-tab" id="prevBtn" aria-label="Previous Phase">
      <span class="tab-text" id="prevTabText">Close-Out &amp; Review</span>
    </button>

    <!-- overflow:visible → the active card protrudes freely -->
    <div class="slider-viewport">

      <!--
        .card-scene has perspective: 1000px → shared vanishing point for all cards.
        NO transform-style: preserve-3d → avoids the browser flattening bug.
        JS only writes data-pos; CSS owns every transform.
      -->
      <div class="card-scene" id="cardScene">

        <article class="slide-card" data-index="0" data-pos="0"
                 style="background-image:url('/slider/slider_0.png')">
          <div class="card-gradient"></div>
          <div class="card-content">
            <h4 class="phase-label">Phase 1</h4>
            <h3 class="slide-title">Project budget preparation</h3>
            <p class="slide-desc">The process begins with a thorough review of project information to establish a clear, accurate, and well-defined budget. Drawings, specifications, and scope requirements are carefully analyzed with a focus on constructability, sequencing, and project intent. This early evaluation creates a solid foundation, aligns expectations, and reduces risk before the project moves forward.</p>
          </div>
        </article>

        <article class="slide-card" data-index="1" data-pos="1"
                 style="background-image:url('/slider/slider_1.png')">
          <div class="card-gradient"></div>
          <div class="card-content">
            <h4 class="phase-label">Phase 2</h4>
            <h3 class="slide-title">Pre-construction planning</h3>
            <p class="slide-desc">Detailed scheduling and coordination take place. We secure necessary permits, finalize vendor agreements, and map out the logistics to ensure a seamless transition to the construction phase. Our proactive approach guarantees that resources are allocated efficiently.</p>
          </div>
        </article>

        <article class="slide-card" data-index="2" data-pos="2"
                 style="background-image:url('/slider/slider_2.png')">
          <div class="card-gradient"></div>
          <div class="card-content">
            <h4 class="phase-label">Phase 3</h4>
            <h3 class="slide-title">Construction &amp; Execution</h3>
            <p class="slide-desc">Our skilled field crews take over, bringing the plans to life. Constant monitoring of safety, quality, and progress ensures that the project stays on track. Regular communication with partners keeps everyone informed and aligned throughout the build.</p>
          </div>
        </article>

        <article class="slide-card" data-index="3" data-pos="-1"
                 style="background-image:url('/slider/slider_3.png')">
          <div class="card-gradient"></div>
          <div class="card-content">
            <h4 class="phase-label">Phase 4</h4>
            <h3 class="slide-title">Close-Out &amp; Review</h3>
            <p class="slide-desc">We perform a comprehensive final inspection, ensuring all punch list items are resolved. The close-out phase also includes a Lesson Learned review to identify successes and areas for improvement, continuously refining our processes for future projects.</p>
          </div>
        </article>

      </div><!-- /card-scene -->

      <div class="navigation-indicators">
        <button class="nav-dot active" data-slide="0" aria-label="Slide 1"></button>
        <button class="nav-dot"        data-slide="1" aria-label="Slide 2"></button>
        <button class="nav-dot"        data-slide="2" aria-label="Slide 3"></button>
        <button class="nav-dot"        data-slide="3" aria-label="Slide 4"></button>
      </div>

    </div><!-- /slider-viewport -->

    <button class="slider-tab next-tab" id="nextBtn" aria-label="Next Phase">
      <span class="tab-text" id="nextTabText">Pre-construction planning</span>
    </button>

  </div>
</section>

<style>
  /* ─── Section ──────────────────────────────────────────────────────────── */
  .avonce-way {
    width: 100%;
    background: #FCFCFC;
    padding: 148px 20px 120px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 64px;
    overflow: hidden;          /* final clip: nothing bleeds past the section */
    transform: scale(0.96);
    transform-origin: center top;
    will-change: transform;
  }

  .header-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 657px;
    text-align: center;
  }

  .heading {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 48px;
    line-height: 1.3;
    letter-spacing: -0.03em;
    color: #1E1E1E;
    margin: 0;
  }

  .text {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.7;
    letter-spacing: -0.02em;
    color: #1B1B1B;
    margin: 0;
  }

  /* ─── Slider shell ─────────────────────────────────────────────────────── */
  .slider-container {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 1296px;
    height: 600px;
  }

  /* Tabs must always sit above any overflowing card */
  .slider-tab {
    width: 93px;
    height: 555px;
    display: flex;
    justify-content: center;
    align-items: center;
    border: none;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    position: relative;
    z-index: 20;               /* always above cards */
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .slider-tab:hover { opacity: 0.9; transform: scaleX(1.05); }

  .prev-tab { background: #1B1B1B; }
  .next-tab  { background: #E6A523; }

  .tab-text {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 24px;
    line-height: 1.4;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .prev-tab .tab-text { color: #F5F4F4; transform: rotate(180deg); writing-mode: vertical-rl; }
  .next-tab .tab-text { color: #1B1B1B; transform: rotate(180deg); writing-mode: vertical-rl; }

  /* ─── Viewport ─────────────────────────────────────────────────────────── */
  /*
   * overflow: visible  → the active card is NOT clipped when it pops forward.
   * z-index: 1         → creates a stacking context so internal z-indices are
   *                       self-contained (doesn't affect overflow behaviour).
   */
  .slider-viewport {
    flex: 1;
    height: 555px;
    position: relative;
    overflow: visible;
    z-index: 1;
  }

  /* ─── 3D scene ─────────────────────────────────────────────────────────── */
  /*
   * perspective is placed here — on the DIRECT parent of the cards.
   * This is the only correct setup: perspective on a parent creates the
   * vanishing-point for its direct children's rotateY / translateZ without
   * needing transform-style: preserve-3d (which breaks with overflow/opacity).
   */
  .card-scene {
    position: absolute;
    inset: 0;
    perspective: 1000px;
    perspective-origin: 50% 50%;
  }

  /* ─── Base card ─────────────────────────────────────────────────────────── */
  .slide-card {
    position: absolute;
    inset: 0;
    background-color: #121212; /* fallback solid background for image loading and contrast */
    background-size: cover;
    background-position: center;
    cursor: pointer;
    /* Smooth transition for every positional change */
    transition:
      transform  0.80s cubic-bezier(0.4, 0, 0.2, 1),
      opacity    0.80s ease,
      box-shadow 0.80s ease;
  }

  /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     CARD POSITION STATES  —  all 3D handled entirely in CSS via data-pos.
     JS writes the attribute; it never touches transform or opacity directly.
     ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */

  /* Active — pops toward the viewer (perspective math: 1000/940 ≈ ×1.06) */
  .slide-card[data-pos="0"] {
    transform: translateZ(60px);
    opacity: 1;
    z-index: 10;
    cursor: default;
    box-shadow:
      0 40px 100px rgba(0, 0, 0, 0.58),
      0  0   0 2px rgba(230, 165, 35, 0.35);
  }

  /* One step to the RIGHT */
  .slide-card[data-pos="1"] {
    transform: translateX(42%) translateZ(-50px) rotateY(-35deg) scale(0.86);
    opacity: 0.65;
    z-index: 7;
    box-shadow: 0 14px 48px rgba(0, 0, 0, 0.38);
  }

  /* One step to the LEFT */
  .slide-card[data-pos="-1"] {
    transform: translateX(-42%) translateZ(-50px) rotateY(35deg) scale(0.86);
    opacity: 0.65;
    z-index: 7;
    box-shadow: 0 14px 48px rgba(0, 0, 0, 0.38);
  }

  /* Two steps to the RIGHT */
  .slide-card[data-pos="2"] {
    transform: translateX(76%) translateZ(-160px) rotateY(-52deg) scale(0.70);
    opacity: 0.25;
    z-index: 4;
    box-shadow: none;
  }

  /* Two steps to the LEFT */
  .slide-card[data-pos="-2"] {
    transform: translateX(-76%) translateZ(-160px) rotateY(52deg) scale(0.70);
    opacity: 0.25;
    z-index: 4;
    box-shadow: none;
  }

  /* ─── Gradient overlay ──────────────────────────────────────────────────── */
  .card-gradient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(18,18,18,0) -24%, #121212 100%),
      linear-gradient(0deg, rgba(18,18,18,.20), rgba(18,18,18,.20));
    transition: background 0.5s ease;
  }

  /* Non-active cards get a heavy dark tint to reinforce depth */
  .slide-card:not([data-pos="0"]) .card-gradient {
    background:
      linear-gradient(180deg, rgba(10,10,10,.50) 0%, rgba(6,6,6,.94) 100%);
  }

  /* ─── Text content — CSS-only visibility tied to data-pos ──────────────── */
  .card-content {
    position: absolute;
    bottom: 80px;
    left: 46px;
    right: 46px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 2;
    pointer-events: none;
    /* Hidden / slid down by default */
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity   0.42s ease 0.28s,
      transform 0.42s ease 0.28s;
  }

  /* Only the front card reveals its content */
  .slide-card[data-pos="0"] .card-content {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    animation: content-float 5.5s ease-in-out 0.7s infinite;
  }

  @keyframes content-float {
    0%, 100% { transform: translateY(0);   }
    50%       { transform: translateY(-6px); }
  }

  .phase-label {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 24px;
    line-height: 1.4;
    color: #E6A523;
    margin: 0;
  }

  .slide-title {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 32px;
    line-height: 1.4;
    color: #F5F4F4;
    margin: 0 0 4px 0;
  }

  .slide-desc {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.7;
    color: #F5F4F4;
    margin: 0;
    max-width: 1018px;
  }

  /* ─── Navigation dots ───────────────────────────────────────────────────── */
  .navigation-indicators {
    position: absolute;
    bottom: -36px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 16px;
    z-index: 30;
  }

  .nav-dot {
    width: 79px;
    height: 6px;
    background: rgba(27, 27, 27, 0.18);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }
  .nav-dot.active { background: #E6A523; }

  /* ─── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .slider-container {
      height: auto;
      flex-direction: column;
    }
    .slider-tab    { display: none; }
    .slider-viewport { width: 100%; height: 500px; flex: none; }
    .slide-card {
      width: 86%;
      left: 7%;
    }
    /* Adjacent peek on tablet */
    .slide-card[data-pos="1"]  { transform: translateX(30%) translateZ(-50px) rotateY(-30deg) scale(0.86); }
    .slide-card[data-pos="-1"] { transform: translateX(-30%) translateZ(-50px) rotateY(30deg)  scale(0.86); }
    .slide-card[data-pos="2"],
    .slide-card[data-pos="-2"] { opacity: 0; pointer-events: none; }
  }

  @media (max-width: 768px) {
    .avonce-way      { padding: 80px 0 100px; transform: none !important; will-change: auto !important; }
    .header-section  { padding: 0 16px; }
    .heading         { font-size: 36px; }
    .phase-label     { font-size: 18px; }
    .slide-title     { font-size: 26px; }
    .slide-desc      { font-size: 16px; }

    .slider-viewport { height: 440px; }

    .slide-card {
      width: 88%;
      left: 6%;
    }

    /* Tighter peek on mobile */
    .slide-card[data-pos="1"]  { transform: translateX(24%) translateZ(-50px) rotateY(-24deg) scale(0.86); }
    .slide-card[data-pos="-1"] { transform: translateX(-24%) translateZ(-50px) rotateY(24deg)  scale(0.86); }
    .slide-card[data-pos="2"],
    .slide-card[data-pos="-2"] { opacity: 0; pointer-events: none; }

    .card-content { bottom: 40px; left: 24px; right: 24px; gap: 6px; }

    .navigation-indicators { bottom: -28px; gap: 8px; }
    .nav-dot { width: 56px; height: 5px; }
  }

  @media (max-width: 480px) {
    .heading         { font-size: 30px; }
    .text            { font-size: 15px; }
    .slider-viewport { height: 460px; }

    .slide-card {
      width: 90%;
      left: 5%;
    }

    .slide-card[data-pos="1"]  { transform: translateX(20%) translateZ(-50px) rotateY(-20deg) scale(0.86); }
    .slide-card[data-pos="-1"] { transform: translateX(-20%) translateZ(-50px) rotateY(20deg)  scale(0.86); }

    .phase-label     { font-size: 16px; }
    .slide-title     { font-size: 20px; }
    .slide-desc      { font-size: 13.5px; line-height: 1.5; }

    .card-content { bottom: 24px; left: 16px; right: 16px; gap: 4px; }
    .nav-dot { width: 44px; }
  }
</style>

<script>
  // Slide titles — used only to keep the side tabs' labels correct.
  const titles = [
    "Project budget preparation",
    "Pre-construction planning",
    "Construction & Execution",
    "Close-Out & Review",
  ];

  const n = titles.length;
  let currentIndex = 0;
  let isAnimating  = false;

  // ── DOM refs (all elements are pre-rendered in HTML) ──────────────────────
  const cards       = Array.from(document.querySelectorAll<HTMLElement>('.slide-card'));
  const navDots     = Array.from(document.querySelectorAll<HTMLElement>('.nav-dot'));
  const prevBtn     = document.getElementById('prevBtn');
  const nextBtn     = document.getElementById('nextBtn');
  const prevTabText = document.getElementById('prevTabText');
  const nextTabText = document.getElementById('nextTabText');

  // ── Core: shortest circular distance from currentIndex to any index ───────
  function relPos(index: number): number {
    let rel = index - currentIndex;
    if (rel >  n / 2) rel -= n;
    if (rel < -n / 2) rel += n;
    return rel;
  }

  // ── Apply state — only attribute & class writes, zero inline styles ───────
  function updateUI() {
    // 3D positions: CSS does ALL visual work based on data-pos
    cards.forEach(card => {
      const idx       = parseInt(card.dataset.index ?? '0', 10);
      card.dataset.pos = String(relPos(idx));
    });

    // Nav dots
    navDots.forEach(dot => {
      const i = parseInt(dot.dataset.slide ?? '0', 10);
      dot.classList.toggle('active', i === currentIndex);
    });

    // Side tab labels
    if (prevTabText) prevTabText.textContent = titles[(currentIndex - 1 + n) % n];
    if (nextTabText) nextTabText.textContent = titles[(currentIndex + 1) % n];
  }

  // ── Navigate ──────────────────────────────────────────────────────────────
  function goTo(index: number) {
    const target = ((index % n) + n) % n;
    if (target === currentIndex || isAnimating) return;
    isAnimating  = true;
    currentIndex = target;
    updateUI();
    setTimeout(() => { isAnimating = false; }, 820);
  }

  // ── Events ────────────────────────────────────────────────────────────────
  cards.forEach(card =>
    card.addEventListener('click', () => {
      const idx = parseInt(card.dataset.index ?? '0', 10);
      goTo(idx);
    })
  );

  navDots.forEach(dot =>
    dot.addEventListener('click', () =>
      goTo(parseInt(dot.dataset.slide ?? '0', 10))
    )
  );

  prevBtn?.addEventListener('click', () => goTo(currentIndex - 1));
  nextBtn?.addEventListener('click', () => goTo(currentIndex + 1));

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'ArrowLeft')  goTo(currentIndex - 1);
    if (e.key === 'ArrowRight') goTo(currentIndex + 1);
  });

  // ── Swipe gestures for touch devices ──────────────────────────────────────
  let touchStartX = 0;
  let touchEndX = 0;
  let touchStartY = 0;
  let touchEndY = 0;

  const viewport = document.querySelector<HTMLElement>('.slider-viewport');
  if (viewport) {
    viewport.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].clientX;
      touchStartY = e.changedTouches[0].clientY;
    }, { passive: true });

    viewport.addEventListener('touchend', (e: TouchEvent) => {
      touchEndX = e.changedTouches[0].clientX;
      touchEndY = e.changedTouches[0].clientY;
      handleSwipe();
    }, { passive: true });
  }

  function handleSwipe() {
    const minDistance = 40; // minimum swipe distance in px
    const diffX = touchEndX - touchStartX;
    const diffY = touchEndY - touchStartY;

    // Ensure it's mostly a horizontal swipe, not vertical scrolling
    if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > minDistance) {
      if (diffX < 0) {
        goTo(currentIndex + 1); // Swiped left -> next
      } else {
        goTo(currentIndex - 1); // Swiped right -> prev
      }
    }
  }

  // Sync tabs on load (cards already have correct data-pos from HTML)
  updateUI();

  // ── Scroll-driven section scale ───────────────────────────────────────────
  const section = document.querySelector<HTMLElement>('.avonce-way');
  if (section) {
    let ticking = false;
    const tick = () => {
      const p = Math.max(0, Math.min(1, 1 - section.getBoundingClientRect().top / window.innerHeight));
      section.style.transform = p >= 1 ? 'none' : `scale(${0.96 + p * 0.04})`;
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { requestAnimationFrame(tick); ticking = true; }
    }, { passive: true });
    tick();
  }
</script>
