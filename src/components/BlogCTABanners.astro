---
// src/components/BlogCTABanners.astro
---

<section class="blog-cta-banners">
  <div class="banner left-banner">
    <div class="content">
      <h2 class="heading">Explore our Integrated<br/>Scopes</h2>
      <a href="/services" class="cta-button">
        <span class="bg-effect"></span>
        <span class="button-label">VIEW SERVICES</span>
      </a>
    </div>
  </div>
  
  <div class="banner right-banner">
    <div class="content">
      <h2 class="heading">Join our<br/>Outstanding Team</h2>
      <a href="/join-us" class="cta-button">
        <span class="bg-effect"></span>
        <span class="button-label">JOIN THE TEAM</span>
      </a>
    </div>
  </div>
</section>

<style>
  .blog-cta-banners {
    display: flex;
    width: 100%;
    height: 600px;
    transform: scale(0.96);
    transform-origin: center top;
    will-change: transform;
  }

  .banner {
    flex: 1;
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: 100px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .left-banner {
    /* Using a fallback image that matches the construction vibe */
    background: linear-gradient(180deg, rgba(18, 18, 18, 0) -23.9%, #121212 100%), 
                url('/section-image.png');
    background-size: cover;
    background-position: center;
  }

  .right-banner {
    /* Using team fallback image */
    background: linear-gradient(180deg, rgba(18, 18, 18, 0) -23.9%, #121212 100%), 
                url('/team1.png');
    background-size: cover;
    background-position: center;
  }

  .content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
    max-width: 568px;
    z-index: 2;
    opacity: 0;
    transform: translateY(4vh);
    will-change: opacity, transform;
  }

  .heading {
    font-family: 'Roboto', sans-serif;
    font-style: normal;
    font-weight: 600;
    font-size: 48px;
    line-height: 130%;
    letter-spacing: -0.03em;
    color: #F5F4F4;
    margin: 0;
  }

  .cta-button {
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 18px 32px;
    gap: 4px;
    position: relative;
    width: 234px;
    height: 67px;
    border: 1px solid #E6A523;
    border-radius: 7.5px;
    background: transparent;
    cursor: pointer;
    overflow: hidden;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .bg-effect {
    position: absolute;
    width: 0;
    height: 100%;
    left: 0;
    top: 0;
    background: #E6A523;
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 0;
  }

  .cta-button:hover .bg-effect {
    width: 100%;
  }

  .button-label {
    position: relative;
    font-family: 'Roboto', sans-serif;
    font-style: normal;
    font-weight: 600;
    font-size: 18px;
    line-height: 170%;
    display: flex;
    align-items: center;
    color: #E6A523;
    z-index: 1;
    transition: color 0.4s ease;
    white-space: nowrap;
  }

  .cta-button:hover .button-label {
    color: #121212;
  }

  /* Responsive Adjustments */
  @media (max-width: 1200px) {
    .banner {
      padding: 60px;
    }
  }

  @media (max-width: 900px) {
    .blog-cta-banners {
      flex-direction: column;
      height: auto;
    }
    
    .banner {
      height: 500px;
      padding: 60px 40px;
    }
    
    .heading {
      font-size: 40px;
    }
  }

  @media (max-width: 600px) {
    .banner {
      height: 400px;
      padding: 40px 20px;
    }
    
    .heading {
      font-size: 32px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const blogCtaSection = document.querySelector('.blog-cta-banners') as HTMLElement;
    const contents = document.querySelectorAll('.blog-cta-banners .content');

    if (blogCtaSection && contents.length > 0) {
      let ticking = false;

      function updateAnimation() {
        const rect = blogCtaSection.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        
        let progress = 1 - (rect.top / windowHeight);
        progress = Math.max(0, Math.min(progress, 1));
        
        if (progress >= 1) {
          blogCtaSection.style.transform = 'none';
        } else {
          const scale = 0.96 + (progress * 0.04);
          blogCtaSection.style.transform = `scale(${scale})`;
        }
        
        const opacity = progress; 
        const yOffset = (1 - progress) * 4;
        
        contents.forEach(content => {
          (content as HTMLElement).style.opacity = opacity.toString();
          (content as HTMLElement).style.transform = `translateY(${yOffset}vh)`;
        });
        
        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(updateAnimation);
          ticking = true;
        }
      }, { passive: true });

      updateAnimation();
    }
  });
</script>
