---
// src/components/BlogHero.astro
---

<section class="blog-hero">
  <div class="container">
    <div class="content" data-reveal>
      <span class="subtle-heading">BLOG</span>
      <h1 class="main-heading">Building Knowledge. Sharing<br/>Experience.</h1>
      <p class="description">
        Sharing knowledge, experience, and perspectives from Avonce's teams across
        multifamily and commercial construction projects.
      </p>
    </div>
  </div>
</section>

<style>
  .blog-hero {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 500px;
    background-color: #FCFCFC;
    padding-top: 96px; /* Offset for fixed navbar */
    display: flex;
    align-items: center; /* Center content vertically */
  }

  .container {
    max-width: 1536px;
    width: 100%;
    margin: 0 auto;
    padding: 0 100px; /* Base padding based on Figma */
  }

  .content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
    max-width: 658px;
    /* Adjust top margin based on the Figma absolute positioning (top: 148px)
       Since we have padding-top: 96px on the section, we need about 52px more 
       to hit the exact visual spacing, or just use padding on the section. 
       We'll use padding on the section to keep it simpler. */
    margin-top: 52px;
    margin-bottom: 52px;
  }

  .subtle-heading {
    font-family: 'Roboto', sans-serif;
    font-style: normal;
    font-weight: 600;
    font-size: 18px;
    line-height: 170%;
    color: #E6A523;
    display: flex;
    align-items: center;
  }

  .main-heading {
    font-family: 'Roboto', sans-serif;
    font-style: normal;
    font-weight: 600;
    font-size: 48px;
    line-height: 130%;
    letter-spacing: -0.03em;
    color: #1E1E1E;
    margin: 0;
  }

  .description {
    font-family: 'Roboto', sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 18px;
    line-height: 170%;
    letter-spacing: -0.02em;
    color: #1B1B1B;
    margin: 0;
  }

  /* Responsive Adjustments */
  @media (max-width: 1024px) {
    .container {
      padding: 0 40px;
    }
  }

  @media (max-width: 768px) {
    .blog-hero {
      min-height: auto;
      padding-bottom: 80px;
    }
    .container {
      padding: 0 20px;
    }
    .content {
      margin-top: 40px;
      margin-bottom: 0;
    }
    .main-heading {
      font-size: 36px;
    }
  }
</style>


