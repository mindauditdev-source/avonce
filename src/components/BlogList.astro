---
// src/components/BlogList.astro

const categories = [
  "All",
  "Project Highlights",
  "Best Practices",
  "Safety",
  "Field Execution",
  "Company News"
];

// Mock data to match the 3x3 grid from the screenshot
const posts = Array(9).fill(null).map((_, i) => {
  const categoryOptions = ["Safety", "Field Execution", "Best Practices"];
  const imageOptions = ["/wood-framing.png", "/section-image.png", "/slider_2.png"];
  return {
    id: i,
    image: imageOptions[i % 3],
    category: categoryOptions[i % 3],
    title: "Best Practices for Client Satisfaction",
    author: "Yesenia Lacruz",
    date: "January 22, 2026",
    readTime: "(4 min read)",
    excerpt: "A client is the person who purchases from a store or who regularly uses the services of a professional or a company. We have internal and external clients. Internal clients are part of the organization, for example: coworkers. External clients are not, for example: general contractors, external inspectors, etc. A client is anyone you serve.",
    link: "#"
  };
});
---

<section class="blog-list-section">
  <div class="container">
    
    <!-- Category Filter -->
    <div class="category-filter">
      {categories.map((category, index) => (
        <a href="#" class={`category-link ${index === 0 ? 'active' : ''}`}>
          {category}
        </a>
      ))}
    </div>

    <!-- Blog Grid -->
    <div class="blog-grid">
      {posts.map((post) => (
        <div class="blog-card">
          <div class="image-wrapper">
            <div class="card-image" style={`background-image: linear-gradient(0deg, rgba(0, 0, 0, 0.25), rgba(0, 0, 0, 0.25)), url('${post.image}');`}></div>
            <div class="category-badge">
              <span>{post.category}</span>
            </div>
          </div>
          
          <div class="card-content">
            <h3 class="card-title">{post.title}</h3>
            
            <div class="card-meta">
              <span class="author">By {post.author}</span>
              <span class="dot"></span>
              <span class="date">{post.date}</span>
              <span class="dot"></span>
              <span class="read-time">{post.readTime}</span>
            </div>
            
            <p class="card-excerpt">
              {post.excerpt}
            </p>
            
            <a href={post.link} class="view-more">View More</a>
          </div>
        </div>
      ))}
    </div>

    <!-- Pagination -->
    <div class="pagination-controls">
      <a href="#" class="pagination-button prev">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6" />
        </svg>
        Back
      </a>
      
      <div class="pages">
        <a href="#" class="page-number">1</a>
        <a href="#" class="page-number active">2</a>
        <a href="#" class="page-number">3</a>
        <a href="#" class="page-number">4</a>
        <a href="#" class="page-number">5</a>
      </div>
      
      <a href="#" class="pagination-button next">
        Next
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18l6-6-6-6" />
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  .blog-list-section {
    position: relative;
    width: 100%;
    background-color: #FCFCFC;
    padding: 100px 0;
    transform: scale(0.96);
    transform-origin: center top;
    will-change: transform;
  }

  .container {
    max-width: 1536px;
    width: 100%;
    margin: 0 auto;
    padding: 0 100px;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  /* Category Filter */
  .category-filter {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .category-link {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 12px;
    line-height: 170%;
    color: #778189;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .category-link.active {
    font-weight: 700;
    color: #1D2D3A;
    text-decoration: underline;
  }

  .category-link:hover {
    color: #1D2D3A;
  }

  /* Blog Grid */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 20px; /* 40px vertical, 20px horizontal */
    width: 100%;
  }

  /* Blog Card */
  .blog-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    will-change: opacity, transform;
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    height: 272px; /* Fixed height for the card image */
    border-radius: 4px;
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
  }

  .category-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 4px 8px;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(6px);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .category-badge span {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 12px;
    line-height: 170%;
    color: #FFFFFF;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card-title {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 170%;
    color: #000000;
    margin: 0;
  }

  .card-meta {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 12px;
    line-height: 170%;
    color: #4A5761;
  }

  .dot {
    width: 2px;
    height: 2px;
    background-color: #4A5761;
    border-radius: 50%;
  }

  .card-excerpt {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 12px;
    line-height: 170%;
    color: #778189;
    margin: 0;
    margin-top: 4px; /* Slight extra gap from meta */
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .view-more {
    font-family: 'Roboto', sans-serif;
    font-weight: 700;
    font-size: 12px;
    line-height: 170%;
    text-decoration: underline;
    color: #E6A523;
    margin-top: 4px;
  }

  /* Pagination */
  .pagination-controls {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 32px;
  }

  .pagination-button {
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 4px;
    height: 36px;
    padding: 8px 12px;
    background: #FFFFFF;
    border: 1px solid #E9E9E9;
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 12px;
    line-height: 170%;
    color: #1B1B1B;
    text-decoration: none;
    transition: background 0.2s;
  }

  .pagination-button:hover {
    background: #f5f5f5;
  }

  .pages {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6px;
  }

  .page-number {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 35px;
    height: 36px;
    background: #FFFFFF;
    border: 1px solid #E9E9E9;
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 12px;
    line-height: 170%;
    color: #313131;
    text-decoration: none;
    transition: all 0.2s;
  }

  .page-number:hover {
    background: #f5f5f5;
  }

  .page-number.active {
    background: #E6A523;
    border-color: #E6A523;
    color: #121212;
    font-weight: 600;
  }

  /* Responsive Adjustments */
  @media (max-width: 1200px) {
    .container {
      padding: 0 40px;
    }
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .blog-list-section {
      padding: 60px 0;
    }
    .container {
      padding: 0 20px;
      gap: 40px;
    }
    .blog-grid {
      grid-template-columns: 1fr;
    }
    .category-filter {
      overflow-x: auto;
      padding-bottom: 12px;
      white-space: nowrap;
      flex-wrap: nowrap;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Scroll Animation Logic for the whole section
    const blogListSection = document.querySelector('.blog-list-section') as HTMLElement;
    if (blogListSection) {
      let ticking = false;

      function updateAnimation() {
        const rect = blogListSection.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        
        let progress = 1 - (rect.top / windowHeight);
        progress = Math.max(0, Math.min(progress, 1));
        
        if (progress >= 1) {
          blogListSection.style.transform = 'none';
        } else {
          const scale = 0.96 + (progress * 0.04);
          blogListSection.style.transform = `scale(${scale})`;
        }
        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(updateAnimation);
          ticking = true;
        }
      }, { passive: true });
      updateAnimation();
    }

    // Staggered entry for blog cards using IntersectionObserver
    const observerOptions = {
      threshold: 0.1,
      rootMargin: "0px 0px -50px 0px"
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const card = entry.target as HTMLElement;
          card.style.opacity = "1";
          card.style.transform = "translateY(0)";
          observer.unobserve(card);
        }
      });
    }, observerOptions);

    const blogCards = document.querySelectorAll('.blog-card');
    blogCards.forEach((card, index) => {
      // Add a small delay based on index for cards in the initial viewport
      const delay = (index % 3) * 0.1;
      (card as HTMLElement).style.transitionDelay = `${delay}s`;
      observer.observe(card);
    });
  });
</script>
