---

const testimonials = [
  {
    quote: "“Overall, it has been a really tight framing job. I am approaching 30 years of experience in framing/carpentry and can tell you that I’m pretty impressed with it for the most part.\n\nIn any event, the QC in regards to being ready for inspections, completing all punch, and working diligently to focus attention where needed in the moment have been second to none in my last 6 yrs of projects as a super. We appreciate the dedication”",
    name: "Johnny Yarbrough",
    role: "Superintendent | Tribridge Residential",
    project: "Project: Brendtwood Apartments"
  },
  {
    quote: "“The team was exceptional from start to finish. We had a very tight deadline and they not only met it but exceeded our expectations in terms of quality and safety. Highly recommended for any large-scale commercial project.”",
    name: "Sarah Jenkins",
    role: "Project Manager | Horizon Developers",
    project: "Project: The Oasis Complex"
  },
  {
    quote: "“Avonce Construction delivered outstanding results on our recent residential development. Their attention to detail and proactive communication made the entire process seamless. We look forward to partnering with them again.”",
    name: "Michael Chen",
    role: "Director of Operations | Urban Build Co.",
    project: "Project: Skyline Lofts"
  }
];
---

<section class="contact-section" id="contact">
  <!-- Building shadow graphic -->
  <div class="vector-bg"></div>

  <div class="container">
    <div class="contact-content">
      <!-- Left Column -->
      <div class="left-col">
        <div class="text-content">
          <span class="subtle-heading">PROVEN BY PERFORMANCE</span>
          <h2 class="main-heading">Ready to Partner on Your Next Project</h2>
        </div>
        
        <a href="/contact" class="contact-button">
          <span class="bg-effect"></span>
          <span class="button-label">CONTACT US</span>
        </a>
      </div>

      <!-- Right Column -->
      <div class="right-col">
        <span class="subtle-heading right-heading">PROVEN THROUGH OUR CLIENTS' EXPERIENCE</span>
        
        <div class="testimonial-slider-container">
          <div class="testimonial-slider">
            {testimonials.map((testimonial, index) => (
              <div class="testimonial-item">
                <p class="testimonial-text">{testimonial.quote}</p>
                
                <div class="testimonial-author">
                  <span class="author-name">{testimonial.name}</span>
                  <span class="author-role">{testimonial.role}</span>
                  <span class="author-project">{testimonial.project}</span>
                </div>
                
                {index !== testimonials.length - 1 && <div class="divider"></div>}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    position: relative;
    width: 100%;
    min-height: 908px;
    background-color: #E6A523;
    display: flex;
    align-items: center;
    padding: 100px 0;
    transform: scale(0.96);
    transform-origin: center top;
  }

  /* The building shadow vector */
  .vector-bg {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 657px;
    height: 488px;
    background-color: #B8841C;
    mask-image: url('/shape-one.svg');
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: bottom right;
    -webkit-mask-image: url('/shape-one.svg');
    -webkit-mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: bottom right;
    z-index: 1;
    pointer-events: none;
  }

  .container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 24px;
    width: 100%;
    position: relative;
    z-index: 2;
  }

  .contact-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 120px;
  }

  /* Left Column */
  .left-col {
    position: sticky;
    top: 150px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 64px;
    max-width: 432px;
    z-index: 10;
  }

  .text-content {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .subtle-heading {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 1.7;
    color: #FCFCFC;
    text-transform: uppercase;
  }

  .main-heading {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 48px;
    line-height: 1.3;
    letter-spacing: -0.03em;
    color: #1B1B1B;
    margin: 0;
  }

  /* Contact Button */
  .contact-button {
    position: relative;
    width: 234px;
    height: 67px;
    border: 1px solid #171003;
    border-radius: 7.5px;
    background: transparent;
    cursor: pointer;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: all 0.3s ease;
  }

  .bg-effect {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 0;
    background-color: #171003;
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 0;
  }

  .contact-button:hover .bg-effect {
    width: 100%;
  }

  .button-label {
    position: relative;
    z-index: 1;
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 1.7;
    color: #2E2107;
    transition: color 0.4s ease;
  }

  .contact-button:hover .button-label {
    color: #FFFFFF;
  }

  /* Right Column */
  .right-col {
    display: flex;
    flex-direction: column;
    gap: 64px;
    max-width: 400px;
    flex: 1;
  }

  .right-heading {
    color: #FFFFFF;
  }

  .testimonial-slider-container {
    width: 100%;
    position: relative;
  }

  .testimonial-slider {
    display: flex;
    flex-direction: column;
    gap: 84px;
    width: 100%;
    max-width: 319px;
    padding: 20px 0;
  }

  .testimonial-item {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .testimonial-text {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.7;
    letter-spacing: -0.02em;
    color: #000000;
    margin: 0;
    white-space: pre-line;
  }

  .testimonial-author {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .author-name {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 1.7;
    letter-spacing: -0.02em;
    color: #000000;
  }

  .author-role, .author-project {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 12px;
    line-height: 1.7;
    color: #000000;
  }

  .divider {
    width: 100%;
    height: 2px;
    background-color: #FFFFFF;
    margin-top: 32px;
  }

  /* Responsive Adjustments */
  @media (max-width: 968px) {
    .contact-content {
      flex-direction: column;
      gap: 80px;
    }

    .testimonial-slider-container {
      height: 400px;
    }
    
    .testimonial-slider {
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    .contact-section {
      min-height: auto;
      padding: 80px 0;
    }

    .main-heading {
      font-size: 36px;
    }

    .vector-bg {
      display: none; /* Hide complex shadow on mobile for performance/layout */
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const section = document.querySelector('.contact-section') as HTMLElement;
    const testimonials = document.querySelectorAll('.testimonial-item');

    if (section) {
      let ticking = false;

      function updateScrollEffects() {
        const rect = section.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        const centerY = windowHeight / 2;

        // Section Scale Hand-off (same as Services)
        let progress = 1 - (rect.top / windowHeight);
        progress = Math.max(0, Math.min(progress, 1));
        
        if (progress >= 1) {
          section.style.transform = 'none';
        } else {
          const scale = 0.96 + (progress * 0.04);
          section.style.transform = `scale(${scale})`;
        }

        // Testimonials fade & smooth parallax
        testimonials.forEach(item => {
          const el = item as HTMLElement;
          const itemRect = el.getBoundingClientRect();
          const itemCenter = itemRect.top + itemRect.height / 2;
          
          // Calculate distance from center of viewport
          const dist = Math.abs(itemCenter - centerY);
          const maxDist = windowHeight / 1.5;
          
          // Ease opacity so it fades out near edges
          let opacity = 1 - Math.pow(dist / maxDist, 2);
          opacity = Math.max(0.1, Math.min(opacity, 1));
          
          // Parallax effect: moves slightly slower than normal scroll
          const offset = (itemCenter - centerY) * 0.15;
          
          el.style.opacity = opacity.toString();
          el.style.transform = `translateY(${offset}px)`;
          el.style.willChange = 'opacity, transform';
        });

        ticking = false;
      }

      updateScrollEffects();

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(updateScrollEffects);
          ticking = true;
        }
      }, { passive: true });
    }
  });
</script>
