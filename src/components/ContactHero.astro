---
// src/components/ContactHero.astro
---

<section class="contact-info" id="contact-info">
  <!-- Florida Map Background -->
  <div class="map-bg"></div>

  <div class="content-wrapper">
    <!-- Heading block -->
    <div class="heading-block" data-reveal>
      <div class="text-group">
        <span class="subtle">CONTACT US</span>
        <h2 class="main-heading">Let's start a conversation.</h2>
        <p class="description">Have a project in mind or a question? We'd love to connect.</p>
      </div>
    </div>

    <!-- Office Location Card -->
    <div class="office-card" data-reveal data-reveal-delay="200">
      <img
        class="office-photo"
        src="/avonce-contactus.png"
        alt="Avonce Construction front desk"
      />
      <div class="office-details">
        <h3 class="city-name">Orlando, Fl</h3>
        <address class="office-address">
          8810 Commodity Cir, Suite 29<br />
          Orlando, Fl 32819
        </address>
        <div class="phone-row">
          <svg class="phone-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20,15.5c-1.2,0-2.4-0.2-3.6-0.6c-0.3-0.1-0.7,0-1,0.2l-2.2,2.2
              c-2.8-1.4-5.1-3.8-6.6-6.6l2.2-2.2c0.3-0.3,0.4-0.7,0.2-1
              c-0.4-1.1-0.6-2.3-0.6-3.5c0-0.6-0.4-1-1-1H5c-0.6,0-1,0.4-1,1
              c0,9.4,7.6,17,17,17c0.6,0,1-0.4,1-1v-3.5C21,15.9,20.6,15.5,20,15.5z"/>
          </svg>
          <a href="tel:4072704808" class="phone-number" style="color: inherit; text-decoration: none;">(407) 270-4808</a>
        </div>
        <a
          class="directions-link"
          href="https://maps.app.goo.gl/DY62r7u8Vk2NDbhMA"
          target="_blank"
          rel="noopener noreferrer"
        >
          Get Directions →
        </a>
      </div>
    </div>

    <!-- Business Development Card -->
    <div class="biz-card" data-reveal data-reveal-delay="400">
      <div class="biz-inner">
        <h3 class="biz-title">Business Development</h3>
        <p class="biz-contact">
          Zeferino Avonce | Founder / President<br />
          <a href="mailto:zef@avonceconstruction.com" style="color: inherit; text-decoration: underline;">zef@avonceconstruction.com</a>
        </p>
        <div class="biz-phone-row">
          <svg class="phone-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20,15.5c-1.2,0-2.4-0.2-3.6-0.6c-0.3-0.1-0.7,0-1,0.2l-2.2,2.2
              c-2.8-1.4-5.1-3.8-6.6-6.6l2.2-2.2c0.3-0.3,0.4-0.7,0.2-1
              c-0.4-1.1-0.6-2.3-0.6-3.5c0-0.6-0.4-1-1-1H5c-0.6,0-1,0.4-1,1
              c0,9.4,7.6,17,17,17c0.6,0,1-0.4,1-1v-3.5C21,15.9,20.6,15.5,20,15.5z"/>
          </svg>
          <a href="tel:4072704808" class="biz-phone" style="color: inherit; text-decoration: none;">(407) 270-4808</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Section container ─────────────────────────────────────── */
  .contact-info {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background: #FCFCFC;
    overflow: hidden;
    padding-top: 96px; /* offset for fixed navbar */
    transform: scale(0.96);
    transform-origin: center top;
    will-change: transform;
  }

  /* ── Florida map background ────────────────────────────────── */
  .map-bg {
    position: absolute;
    top: 157px;
    right: 0;
    width: 80%;
    max-width: 1228px;
    height: calc(100% - 157px);
    background-image: url('/mapa.png');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: right center;
    pointer-events: none;
    z-index: 0;
  }

  /* ── Content wrapper ───────────────────────────────────────── */
  .content-wrapper {
    position: relative;
    z-index: 1;
    max-width: 1536px;
    padding: 0 100px;
    margin: 0 auto;
  }

  /* ── Heading block ─────────────────────────────────────────── */
  .heading-block {
    padding-top: 148px;
    max-width: 658px;
  }

  .text-group {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .subtle {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 170%;
    color: #E6A523;
    display: block;
  }

  .main-heading {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 48px;
    line-height: 130%;
    letter-spacing: -0.03em;
    color: #1E1E1E;
    margin: 0;
  }

  .description {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 170%;
    letter-spacing: -0.02em;
    color: #1B1B1B;
    margin: 0;
  }

  /* ── Office card ───────────────────────────────────────────── */
  .office-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 20px;
    margin-top: 64px; /* 148 + 188 + 64 spacing ≈ 400 from top of section */
    max-width: 545px;
  }

  .office-photo {
    width: 206px;
    height: 218px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .office-details {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1;
  }

  .city-name {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 32px;
    line-height: 140%;
    letter-spacing: -0.03em;
    color: #000000;
    margin: 0;
  }

  .office-address {
    font-family: 'Roboto', sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 18px;
    line-height: 170%;
    letter-spacing: -0.02em;
    color: #000000;
  }

  .phone-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    color: #000000;
  }

  .phone-icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
  }

  .phone-number {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 170%;
    color: #000000;
  }

  .directions-link {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 170%;
    color: #E6A523;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .directions-link:hover {
    opacity: 0.75;
  }

  /* ── Business Development card ─────────────────────────────── */
  .biz-card {
    box-sizing: border-box;
    max-width: 545px;
    border: 2px solid #000000;
    padding: 56px;
    margin-top: 64px;
    margin-bottom: 120px;
  }

  .biz-inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .biz-title {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 32px;
    line-height: 140%;
    letter-spacing: -0.03em;
    color: #000000;
    margin: 0;
  }

  .biz-contact {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 170%;
    letter-spacing: -0.02em;
    color: #000000;
    margin: 0;
  }

  .biz-phone-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4px;
    color: #000000;
  }

  .biz-phone {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 170%;
    letter-spacing: -0.02em;
    color: #000000;
  }

  /* ── Responsive ────────────────────────────────────────────── */
  @media (max-width: 1200px) {
    .content-wrapper {
      padding: 0 60px;
    }
    .map-bg {
      width: 65%;
    }
  }

  @media (max-width: 900px) {
    .contact-info {
      min-height: 100vh;
      padding-bottom: 80px;
    }
    .content-wrapper {
      padding: 0 40px;
    }
    .map-bg {
      display: none;
    }
    .main-heading {
      font-size: 36px;
    }
  }

  @media (max-width: 600px) {
    .content-wrapper {
      padding: 0 20px;
    }
    .heading-block {
      padding-top: 80px;
    }
    .office-card {
      flex-direction: column;
      align-items: flex-start;
    }
    .office-photo {
      width: 100%;
      height: 200px;
    }
    .biz-card {
      padding: 32px 24px;
    }
    .main-heading {
      font-size: 28px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const section = document.querySelector('.contact-info') as HTMLElement;
    if (!section) return;

    let ticking = false;

    function updateAnimation() {
      const rect = section.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      
      let progress = 1 - (rect.top / windowHeight);
      progress = Math.max(0, Math.min(progress, 1));
      
      if (progress >= 1) {
        section.style.transform = 'none';
      } else {
        const scale = 0.96 + (progress * 0.04);
        section.style.transform = `scale(${scale})`;
      }
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateAnimation);
        ticking = true;
      }
    }, { passive: true });

    updateAnimation();
  });
</script>
