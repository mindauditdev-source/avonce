---
// src/components/CoreValues.astro

const valuesList = [
  {
    title: "Integrity",
    description: "We hold ourselves to the highest standard of honesty and transparency — with our clients, our team, and our trade partners. Every commitment we make is one we intend to keep, and every decision is guided by what is right, not what is easy.",
    images: ["/about/image.png", "/about/image1.png"]
  },
  {
    title: "Safety",
    description: "Safety is not a checkbox — it is a culture. We implement rigorous safety protocols on every job site, ensuring our crews go home the same way they arrived. Our safety-first mindset protects our people, our clients, and the communities we build in.",
    images: ["/about/image1.png", "/about/image.png"]
  },
  {
    title: "Quality",
    description: "Precision and craftsmanship define every phase of our work. From preconstruction coordination to final closeout, we maintain consistent installation standards and thorough quality control processes that our General Contractor partners can depend on.",
    images: ["/about/image.png", "/about/image1.png"]
  },
  {
    title: "Respect",
    description: "We treat every person on a project — from the project manager to the field laborer — with dignity and professionalism. A culture of mutual respect drives better communication, stronger teamwork, and ultimately, better results for everyone involved.",
    images: ["/about/image1.png", "/about/image.png"]
  },
  {
    title: "Compliance",
    description: "We operate in full alignment with all applicable codes, regulations, and contractual requirements. Our teams are trained to understand and uphold FHA/ADA standards, building codes, and submission protocols — protecting our clients from costly delays and liabilities.",
    images: ["/about/image.png", "/about/image1.png"]
  },
  {
    title: "Sustainability",
    description: "We are committed to responsible construction practices that minimize waste, reduce environmental impact, and support long-term project value. As we grow, we continue to explore sustainable methods and materials that benefit both our clients and the environment.",
    images: ["/about/image1.png", "/about/image.png"]
  }
];
---

<section id="core-values" class="core-values">
  <div class="container" data-reveal>
    
    <div class="header-content">
      <span class="subtle-heading">ABOUT US</span>
      <h2 class="main-heading">Our Core Values</h2>
      <p class="desc-text">We foster a transparent work environment built on trust, accountability, and ethical conduct—on every project and in every interaction.</p>
    </div>

    <div class="values-content">
      <!-- Left Column: Accordion / Tabs -->
      <div class="values-list">
        {valuesList.map((val, i) => (
          <div class={`value-item ${i === 0 ? 'active' : ''}`} data-index={i}>
            <div class="value-item-content">
              <div class="icon-house">
                <!-- Avonce "A" imagotipo — only the house/A mark, no wordmark -->
                <svg width="28" height="28" viewBox="0 0 42 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M0 12.109V30.5912H12.0755V18.4151L28.9476 8.55347V30.5912H41.1908L41.1573 15.0608L22.239 0L0 12.109Z" fill="currentColor"/>
                </svg>
              </div>
              <h3 class="value-title">{val.title}</h3>
            </div>
            <div class="icon-toggle">{i === 0 ? '+' : '-'}</div>
          </div>
        ))}
      </div>

      <!-- Right Column: Content (swapped on click) -->
      <div class="values-details">
        {valuesList.map((val, i) => (
          <div class={`value-panel ${i === 0 ? 'panel-active' : ''}`} data-panel={i}>
            <p class="details-text">{val.description}</p>
            <div class="images-grid">
              <div class="img-wrapper">
                <img src={val.images[0]} alt={val.title + " image 1"} />
              </div>
              <div class="img-wrapper">
                <img src={val.images[1]} alt={val.title + " image 2"} />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
    
  </div>
</section>

<style>
  .core-values {
    width: 100%;
    background: #FFFFFF;
    padding: 100px 0;
    position: relative;
    transform: scale(0.96);
    transform-origin: center top;
    will-change: transform;
  }

  .container {
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: 0 100px;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  /* Header Section */
  .header-content {
    max-width: 544px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .subtle-heading {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 1.7;
    color: #E6A523;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .main-heading {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 48px;
    line-height: 1.3;
    letter-spacing: -0.03em;
    color: #1E1E1E;
    margin: 0;
  }

  .desc-text {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.7;
    letter-spacing: -0.02em;
    color: #1B1B1B;
    margin: 0;
  }

  /* Main Content Layout */
  .values-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 60px;
  }

  /* Left Column (Accordion) */
  .values-list {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 441px;
    flex-shrink: 0;
  }

  .value-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid #D6D6D6;
    color: #ABABAB;
    cursor: pointer;
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .value-item.active {
    border-bottom-color: #E6A523;
    color: #E6A523;
  }

  .value-item-content {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .icon-house {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
  }

  .value-title {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 32px;
    line-height: 1.4;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .icon-toggle {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 24px;
    flex-shrink: 0;
  }

  /* Right Column (Details) */
  .values-details {
    display: flex;
    flex-direction: column;
    max-width: 771px;
    width: 100%;
    position: relative;
    min-height: 380px;
  }

  /* Individual panels — hidden by default, shown when active */
  .value-panel {
    display: none;
    flex-direction: column;
    gap: 40px;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .value-panel.panel-active {
    display: flex;
    opacity: 1;
    transform: translateY(0);
  }

  .value-panel.panel-entering {
    display: flex;
    opacity: 0;
    transform: translateY(12px);
  }

  .details-text {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 19px;
    line-height: 1.7;
    letter-spacing: -0.02em;
    color: #121212;
    margin: 0;
  }

  .images-grid {
    display: flex;
    gap: 17px;
    width: 100%;
  }

  .img-wrapper {
    flex: 1;
    position: relative;
    height: 268px;
    border-radius: 4px;
    overflow: hidden;
  }

  .img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .img-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(18, 18, 18, 0) 50%, rgba(18, 18, 18, 0.5) 100%);
    pointer-events: none;
  }

  /* Responsive Adjustments */
  @media (max-width: 1200px) {
    .values-content {
      flex-direction: column;
    }
    
    .values-list, .values-details {
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    .core-values {
      transform: none !important;
      will-change: auto !important;
    }
    .container {
      padding: 0 20px;
    }
    
    .images-grid {
      flex-direction: column;
    }
    
    .main-heading {
      font-size: 36px;
    }
    
    .value-title {
      font-size: 24px;
    }
  }
</style>

<script>
  function initCoreValues() {
    const items = document.querySelectorAll('.value-item');
    const panels = document.querySelectorAll('.value-panel');

    function activateItem(index: number) {
      // Update left column
      items.forEach((item, i) => {
        item.classList.toggle('active', i === index);
        const toggle = item.querySelector('.icon-toggle');
        if (toggle) toggle.textContent = i === index ? '+' : '-';
      });

      // Update right column with fade transition
      panels.forEach((panel, i) => {
        const el = panel as HTMLElement;
        if (i === index) {
          el.classList.add('panel-entering');
          el.style.display = 'flex';
          // Force reflow
          void el.offsetHeight;
          el.classList.remove('panel-entering');
          el.classList.add('panel-active');
        } else {
          el.classList.remove('panel-active', 'panel-entering');
          el.style.display = 'none';
        }
      });
    }

    items.forEach((item, i) => {
      item.addEventListener('click', () => activateItem(i));
    });

    // Initialize first item
    activateItem(0);
  }

  // Scroll Animation Logic (Section Scaling only)
  function initScrollAnimation() {
    const coreValuesSection = document.querySelector('.core-values') as HTMLElement;

    if (coreValuesSection) {
      let ticking = false;

      function updateAnimation() {
        const rect = coreValuesSection.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        
        let progress = 1 - (rect.top / windowHeight);
        progress = Math.max(0, Math.min(progress, 1));
        
        if (progress >= 1) {
          coreValuesSection.style.transform = 'none';
        } else {
          const scale = 0.96 + (progress * 0.04);
          coreValuesSection.style.transform = `scale(${scale})`;
        }
        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(updateAnimation);
          ticking = true;
        }
      }, { passive: true });

      updateAnimation();
    }
  }

  initCoreValues();
  initScrollAnimation();

  document.addEventListener('astro:after-swap', () => {
    initCoreValues();
    initScrollAnimation();
  });
</script>
