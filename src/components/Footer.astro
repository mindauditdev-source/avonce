---
// src/components/Footer.astro
---

<footer class="footer">
  <div class="footer-container">
    <!-- Top row: Logo and Nav Links -->
    <div class="footer-top">
      <div class="footer-logo">
        <a href="/">
          <svg width="234" height="40" viewBox="0 0 234 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M5 20L20 5L35 20V35H28V22H12V35H5V20Z" fill="#FCFCFC"/>
            <text x="45" y="32" fill="#FCFCFC" style="font-family: 'Roboto', sans-serif; font-weight: 700; font-size: 32px; letter-spacing: -0.02em;">VONCE</text>
          </svg>
        </a>
      </div>
      
      <div class="nav-links">
        <a href="/about" class="nav-link">ABOUT</a>
        <a href="#expertise" class="nav-link">EXPERTISE</a>
        <a href="#join" class="nav-link">JOIN OUR TEAM</a>
        <a href="/blog" class="nav-link">BLOG</a>
        <a href="/contact" class="nav-link">CONTACT</a>
      </div>
    </div>

    <!-- Middle: Huge subtle gradient logo -->
    <div class="footer-middle">
      <div class="huge-logo">
        <svg width="100%" height="183" viewBox="0 0 1000 183" preserveAspectRatio="xMidYMid meet" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="huge-logo-gradient" x1="0" y1="0" x2="0" y2="183" gradientUnits="userSpaceOnUse">
              <stop stop-color="#0E0E0E"/>
              <stop offset="1" stop-color="#121212"/>
            </linearGradient>
          </defs>
          <path d="M22 135L100 35L178 135V183H140V140H60V183H22V135Z" fill="url(#huge-logo-gradient)"/>
          <text x="210" y="180" fill="url(#huge-logo-gradient)" style="font-family: 'Roboto', sans-serif; font-weight: 900; font-size: 200px; letter-spacing: -0.02em;">VONCE</text>
        </svg>
      </div>
    </div>

    <!-- Bottom row: Copyright, Terms and Social Icons -->
    <div class="footer-bottom">
      <div class="footer-bottom-left">
        <span class="copyright">©2026 Avonce Company, LLC</span>
        <a href="#privacy" class="footer-link">Privacy Statement</a>
        <a href="#terms" class="footer-link">Terms of Service</a>
        <a href="#cookies" class="footer-link">Cookie Policy</a>
      </div>
      
      <div class="social-links">
        <!-- Facebook -->
        <a href="#" aria-label="Facebook">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A3A9AD" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
        <!-- Twitter/X -->
        <a href="#" aria-label="Twitter">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A3A9AD" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
        </a>
        <!-- LinkedIn -->
        <a href="#" aria-label="LinkedIn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A3A9AD" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
        <!-- Instagram -->
        <a href="#" aria-label="Instagram">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A3A9AD" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
        <!-- YouTube -->
        <a href="#" aria-label="YouTube">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A3A9AD" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33 2.78 2.78 0 0 0 1.94 2c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.33 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    width: 100%;
    height: 562px;
    background: #121212;
    display: flex;
    flex-direction: column;
    justify-content: flex-end; /* Align to bottom, then position contents absolutely or let them flex */
  }

  .footer-container {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /* Top Section */
  .footer-top {
    position: absolute;
    height: 32px;
    left: 100px;
    right: 100px;
    top: 74px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-links {
    display: flex;
    gap: 28px;
    align-items: center;
  }

  .nav-link {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 1.7;
    text-transform: uppercase;
    color: #FFFFFF;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .nav-link:hover {
    opacity: 0.7;
    color: #E6A523;
  }

  /* Middle Vector */
  .footer-middle {
    position: absolute;
    height: 183px;
    left: 100px;
    right: 100px;
    bottom: 124px;
    display: flex;
    justify-content: center;
    align-items: center;
    user-select: none;
    pointer-events: none;
  }

  .huge-logo {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Bottom Section */
  .footer-bottom {
    position: absolute;
    height: 20px;
    left: 100px;
    right: 100px;
    bottom: 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-bottom-left {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .copyright, .footer-link {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 12px;
    line-height: 1.7;
    color: #A4A9AD;
  }

  .footer-link {
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .footer-link:hover {
    color: #FFFFFF;
  }

  .social-links {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .social-links a:hover {
    transform: translateY(-2px);
  }

  .social-links svg {
    transition: stroke 0.3s ease;
  }

  .social-links a:hover svg {
    stroke: #FFFFFF;
  }

  /* Responsive styling */
  @media (max-width: 1024px) {
    .footer-top, .footer-middle, .footer-bottom {
      left: 40px;
      right: 40px;
    }
  }

  @media (max-width: 768px) {
    .footer {
      height: auto;
      min-height: 400px;
      padding: 60px 20px 40px;
    }
    .footer-container {
      position: static;
      display: flex;
      flex-direction: column;
      gap: 60px;
    }
    .footer-top {
      position: static;
      height: auto;
      flex-direction: column;
      gap: 32px;
      align-items: flex-start;
    }
    .nav-links {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .footer-middle {
      position: static;
      height: auto;
    }
    .footer-bottom {
      position: static;
      height: auto;
      flex-direction: column-reverse;
      gap: 32px;
      align-items: flex-start;
    }
    .footer-bottom-left {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
