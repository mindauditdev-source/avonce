<style>
  .footer {
    position: relative;
    width: 100%;
    height: 562px;
    background: #121212;
    display: flex;
    flex-direction: column;
    justify-content: flex-end; /* Align to bottom, then position contents absolutely or let them flex */
  }

  .footer-container {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /* Top Section */
  .footer-top {
    position: absolute;
    height: 32px;
    left: 100px;
    right: 100px;
    top: 74px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-links {
    display: flex;
    gap: 28px;
    align-items: center;
  }

  .nav-link {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 1.7;
    text-transform: uppercase;
    color: #FFFFFF;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .nav-link:hover {
    opacity: 0.7;
    color: #E6A523;
  }

  /* Middle Vector */
  .footer-middle {
    position: absolute;
    height: 183px;
    left: 100px;
    right: 100px;
    bottom: 124px;
    display: flex;
    justify-content: center;
    align-items: center;
    user-select: none;
    pointer-events: none;
  }

  .huge-logo {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .logo-overlay {
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
  }

  .footer.active-logo .logo-overlay {
    opacity: 1;
  }

  /* Bottom Section */
  .footer-bottom {
    position: absolute;
    height: 20px;
    left: 100px;
    right: 100px;
    bottom: 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-bottom-left {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .copyright, .footer-link {
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 12px;
    line-height: 1.7;
    color: #A4A9AD;
  }

  .footer-link {
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .footer-link:hover {
    color: #FFFFFF;
  }

  .social-links {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .social-links a:hover {
    transform: translateY(-2px);
  }

  .social-links svg {
    transition: stroke 0.3s ease;
  }

  .social-links a:hover svg {
    stroke: #FFFFFF;
  }

  /* Responsive styling */
  @media (max-width: 1024px) {
    .footer-top, .footer-middle, .footer-bottom {
      left: 40px;
      right: 40px;
    }
  }

  @media (max-width: 768px) {
    .footer {
      height: auto;
      min-height: 400px;
      padding: 60px 20px 40px;
    }
    .footer-container {
      position: static;
      display: flex;
      flex-direction: column;
      gap: 60px;
    }
    .footer-top {
      position: static;
      height: auto;
      flex-direction: column;
      gap: 32px;
      align-items: flex-start;
    }
    .nav-links {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .footer-middle {
      position: static;
      height: auto;
    }
    .footer-bottom {
      position: static;
      height: auto;
      flex-direction: column-reverse;
      gap: 32px;
      align-items: flex-start;
    }
    .footer-bottom-left {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const footer = document.querySelector('.footer') as HTMLElement;
    
    if (footer) {
      let ticking = false;
      
      function checkFooterScroll() {
        const rect = footer.getBoundingClientRect();
        // Si el borde inferior del footer está a la misma altura que la ventana (o casi, margen de 10px)
        if (rect.bottom <= window.innerHeight + 10) {
          footer.classList.add('active-logo');
        } else {
          footer.classList.remove('active-logo');
        }
        ticking = false;
      }
      
      // Chequeo inicial por si la página carga directamente abajo
      checkFooterScroll();
      
      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(checkFooterScroll);
          ticking = true;
        }
      }, { passive: true });
    }
  });
</script>
