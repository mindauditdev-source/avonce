<style>
  .footer {
    position: relative;
    z-index: 1;
    width: 100%;
    min-height: 560px;
    background: #121212;
    padding-bottom: 32px;
  }

  .footer-container {
    position: relative;
    width: 100%;
    min-height: 500px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  /* Top Section */
  .footer-top {
    position: absolute;
    height: 32px;
    left: 100px;
    right: 100px;
    top: 74px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-links {
    display: flex;
    gap: 28px;
    align-items: center;
  }

  .nav-link {
    font-family: "Roboto", sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 1.7;
    text-transform: uppercase;
    color: #ffffff;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .nav-link:hover {
    opacity: 0.7;
    color: #e6a523;
  }

  /* Middle Vector */
  .footer-middle {
    position: absolute;
    height: 183px;
    left: 100px;
    right: 100px;
    bottom: 164px;
    display: flex;
    justify-content: center;
    align-items: center;
    user-select: none;
    pointer-events: none;
  }

  .huge-logo {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .logo-overlay {
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
  }

  .footer.active-logo .logo-overlay {
    opacity: 1;
  }

  /* Bottom Section */
  .footer-bottom {
    position: relative;

    width: calc(100% - 200px);
    margin: 0 auto;
    padding-top: 8px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }

  .footer-bottom-left {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: center;
  }

  .copyright,
  .footer-link {
    font-family: "Roboto", sans-serif;
    font-weight: 400;
    font-size: 12px;
    line-height: 1.7;
    color: #a4a9ad;
  }

  .footer-link {
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .footer-link:hover {
    color: #ffffff;
  }

  .social-links {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .social-links a:hover {
    transform: translateY(-2px);
  }

  .social-links svg {
    transition: stroke 0.3s ease;
  }

  .social-links a:hover svg {
    stroke: #ffffff;
  }

  /* Responsive styling */
  @media (max-width: 1024px) {
    .footer-top,
    .footer-middle,
    .footer-bottom {
      left: 40px;
      right: 40px;
    }
  }

  @media (max-width: 768px) {
    /* ── Footer shell: 390px wide, 505px tall, centered ────────── */
    .footer {
      height: auto;
      min-height: unset;
      padding: 0;
    }

    .footer-container {
      position: relative;
      width: 100%;
      height: 505px;
      min-height: 505px;
      display: block; /* back to absolute children */
    }

    /* ── Logo: top 44px, left 16px ──────────────────────────────── */
    .footer-top {
      position: absolute;
      top: 44px;
      left: 16px;
      right: 16px;
      height: auto;
      flex-direction: row;
      justify-content: flex-start;
      align-items: center;
    }

    .footer-logo svg {
      width: 169px;
      height: auto;
    }

    /* ── Nav links: top 105px, left 16px, row wrap, gap 28px ────── */
    .nav-links {
      position: absolute;
      top: 105px;
      left: 16px;
      width: 358px;
      max-width: calc(100% - 32px);
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
      align-content: flex-start;
      gap: 28px;
    }

    .nav-link {
      font-size: 16px;
      line-height: 170%;
      height: 27px;
      display: flex;
      align-items: center;
    }

    /* ── Watermark logo: absolute, bottom 185px ──────────────────── */
    .footer-middle {
      position: absolute;
      left: 16px;
      right: 16px;
      bottom: 185px;
      height: 49px;
    }

    /* ── Bottom info row: top 353px, left 16px, row wrap, gap 8px── */
    .footer-bottom {
      position: absolute;
      top: 353px;
      left: 16px;
      width: 228px;
      padding-top: 0;
      margin: 0;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      align-content: flex-start;
      gap: 0 8px;
      row-gap: 0;
      justify-content: flex-start;
    }

    .footer-bottom-left {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 0 8px;
      row-gap: 0;
      order: 1;
    }

    /* Hide phone/email from bottom row (not in Figma mobile) */
    .footer-bottom-left a[href^="tel:"],
    .footer-bottom-left a[href^="mailto:"] {
      display: none;
    }

    /* Social icons: flow below text, order 2 so text is first */
    .social-links {
      position: static;
      margin-top: 16px;
      margin-left: 0;
      width: 93px;
      gap: 6.4px;
      order: 2;
    }

    .social-links svg {
      width: 16px;
      height: 16px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const footer = document.querySelector(".footer") as HTMLElement;

    if (footer) {
      let ticking = false;

      function checkFooterScroll() {
        const rect = footer.getBoundingClientRect();
        // Si el borde inferior del footer está a la misma altura que la ventana (o casi, margen de 10px)
        if (rect.bottom <= window.innerHeight + 10) {
          footer.classList.add("active-logo");
        } else {
          footer.classList.remove("active-logo");
        }
        ticking = false;
      }

      // Chequeo inicial por si la página carga directamente abajo
      checkFooterScroll();

      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            window.requestAnimationFrame(checkFooterScroll);
            ticking = true;
          }
        },
        { passive: true },
      );
    }
  });
</script>
