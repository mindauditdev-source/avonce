<section class="gallery-grid">
  <div class="grid-container">
    <div class="pages">
      <div class="page active" data-page="1">
        <!-- Row 1 -->
        <div class="row row-3" data-reveal>
          {
            projects.slice(0, 3).map((p) => (
              <div 
                class="banner project-trigger" 
                data-project={JSON.stringify(p)}
              >
                <div class="banner-bg" style={`background-image: url(${p.image})`} />
                <div class="overlay" />
                <div class="content">
                  <h4>{p.title}</h4>
                  <p>{p.location}</p>
                </div>
              </div>
            ))
          }
        </div>

        <!-- Row 2 -->
        <div class="row row-mix-1-2" data-reveal>
          {
            projects.slice(3, 5).map((p) => (
              <div
                class={`banner project-trigger ${
                  p.size === "xl" ? "banner-xl" : ""
                }`}
                data-project={JSON.stringify(p)}
              >
                <div class="banner-bg" style={`background-image: url(${p.image})`} />
                <div class="overlay" />
                <div class="content">
                  <h4>{p.title}</h4>
                  <p>{p.location}</p>
                </div>
              </div>
            ))
          }
        </div>

        <!-- Row 3 -->
        <div class="row row-3" data-reveal>
          {
            projects.slice(5, 8).map((p) => (
              <div 
                class="banner project-trigger" 
                data-project={JSON.stringify(p)}
              >
                <div class="banner-bg" style={`background-image: url(${p.image})`} />
                <div class="overlay" />
                <div class="content">
                  <h4>{p.title}</h4>
                  <p>{p.location}</p>
                </div>
              </div>
            ))
          }
        </div>

        <!-- Row 4 -->
