    display: flex;
    align-items: center;
    letter-spacing: -0.02em;
    color: #e6a523;
    margin: 0;
  }

  p {
    position: absolute;
    width: 412px;
    height: 81px;
    left: 64px;
    top: 211px;
    font-family: "Roboto", sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 170%;
    display: flex;
    align-items: center;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0;
  }

  .pages {
    position: relative;
  }

  .page {
    display: none;
  }

  .page.active {
    display: block;
  }

  .coming-soon {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 1314px;
    text-align: center;
  }

  .coming-soon h2 {
    font-family: "Roboto", sans-serif;
    font-weight: 600;
    font-size: 36px;
    color: #e6a523;
    margin: 0 0 12px;
  }

  .coming-soon p {
    position: static;
    width: auto;
    height: auto;
    font-family: "Roboto", sans-serif;
    font-weight: 400;
    font-size: 18px;
    color: #ffffff;
    margin: 0;
  }

  /* Pagination */
  .pagination {
    margin: 60px 0 100px;
    display: flex;
    gap: 6px;
    justify-content: center;
    align-items: center;
  }

  .page-control,
  .page-num {
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border: 1px solid #e9e9e9;
    font-family: "Roboto", sans-serif;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
    user-select: none;
    outline: none;
    padding: 0;
  }

  .page-control {
    padding: 8px 12px;
    gap: 4px;
    color: #1b1b1b;
  }

  .page-num {
    width: 35px;
    color: #313131;
  }

  .page-num.active {
    background: #e6a523;
    border-color: #e6a523;
    color: #121212;
    font-weight: 600;
  }

  .page-num:hover:not(.active),
  .page-control:hover {
    background: #f5f5f5;
  }

  /* Responsive */
  @media (max-width: 1200px) {
    .grid-container {
      padding: 0 20px;
    }
    .row-mix-1-2 .banner,
    .row-mix-2-1 .banner {
      flex: 1;
    }
  }

  @media (max-width: 768px) {
    .row {
      flex-direction: column;
      height: auto;
    }
    .banner {
      height: 324px;
      flex: none !important;
      width: 100% !important;
    }
    .content {
      max-width: 100%;
    }
    .pagination {
      flex-wrap: wrap;
      padding: 0 20px;
    }
    h4 {
      width: calc(100% - 64px);
      font-size: 20px;
    }
    p {
      width: calc(100% - 96px);
      font-size: 14px;
      top: auto;
      bottom: 32px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const galleryGridSection = document.querySelector('.gallery-grid') as HTMLElement;

    if (galleryGridSection) {
      let ticking = false;

      function updateAnimation() {
        const rect = galleryGridSection.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        
        let progress = 1 - (rect.top / windowHeight);
        progress = Math.max(0, Math.min(progress, 1));
        
        if (progress >= 1) {
          galleryGridSection.style.transform = 'none';
        } else {
          const scale = 0.96 + (progress * 0.04);
          galleryGridSection.style.transform = `scale(${scale})`;
        }
        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(updateAnimation);
          ticking = true;
        }
      }, { passive: true });

      updateAnimation();
    }
  });
</script>
