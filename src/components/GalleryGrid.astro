---

<section class="gallery-grid">
  <div class="grid-container">
    <!-- Row 1 -->
    <div class="row row-3" data-reveal>
      {
        projects.slice(0, 3).map((p) => (
          <div 
            class="banner project-trigger" 
            data-project={JSON.stringify(p)}
          >
            <div class="banner-bg" style={`background-image: url(${p.image})`} />
            <div class="overlay" />
            <div class="content">
              <h4>{p.title}</h4>
              <p>{p.location}</p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Row 2 -->
    <div class="row row-mix-1-2" data-reveal>
      {
        projects.slice(3, 5).map((p) => (
          <div
            class={`banner project-trigger ${
              p.size === "xl" ? "banner-xl" : ""
            }`}
            data-project={JSON.stringify(p)}
          >
            <div class="banner-bg" style={`background-image: url(${p.image})`} />
            <div class="overlay" />
            <div class="content">
              <h4>{p.title}</h4>
              <p>{p.location}</p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Row 3 -->
    <div class="row row-3" data-reveal>
      {
        projects.slice(5, 8).map((p) => (
          <div 
            class="banner project-trigger" 
            data-project={JSON.stringify(p)}
          >
            <div class="banner-bg" style={`background-image: url(${p.image})`} />
            <div class="overlay" />
            <div class="content">
              <h4>{p.title}</h4>
              <p>{p.location}</p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Row 4 -->
    <div class="row row-mix-2-1" data-reveal>
      {
        projects.slice(8, 10).map((p) => (
          <div
            class={`banner project-trigger ${
              p.size === "xl" ? "banner-xl" : ""
            }`}
            data-project={JSON.stringify(p)}
          >
            <div class="banner-bg" style={`background-image: url(${p.image})`} />
            <div class="overlay" />
            <div class="content">
              <h4>{p.title}</h4>
              <p>{p.location}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
  ...
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const triggers = document.querySelectorAll(".project-trigger");
      triggers.forEach((t) => {
        t.addEventListener("click", () => {
          const projectData = JSON.parse(t.getAttribute("data-project"));
          if (window.openProjectModal) {
            window.openProjectModal(projectData);
          }
        });
      });
    });
  </script>
</section>



<style>
  .gallery-grid {
    width: 100%;
    background: #121212;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: scale(0.96);
    transform-origin: center top;
    will-change: transform;
  }

  .grid-container {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
    max-width: 1536px;
  }

  .row {
    display: flex;
    gap: 6px;
    height: 324px;
    width: 100%;
  }

  .banner {
    position: relative;
    height: 100%;
    background: #1e1e1e; /* Fallback color */
    flex: 1;
    overflow: hidden;
    cursor: pointer;
  }

  .banner-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    z-index: 0;
  }

  .banner:hover .banner-bg {
    transform: scale(1.08);
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6));
    transition: opacity 0.3s ease;
  }

  .banner:hover .overlay {
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4));
  }

  .banner-xl {
    flex: 2;
  }

  /* Pixel perfect widths from Figma for 1536px width */
  .row-mix-1-2 .banner:not(.banner-xl) {
    flex: 0 0 508px;
  }
  .row-mix-1-2 .banner-xl {
    flex: 0 0 1022px;
  }

  .row-mix-2-1 .banner-xl {
    flex: 0 0 1022px;
  }
  .row-mix-2-1 .banner:not(.banner-xl) {
    flex: 0 0 508px;
  }

  .content {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  h4 {
    position: absolute;
    width: 445px;
    height: 34px;
    left: 32px;
    top: 32px;
    font-family: "Roboto", sans-serif;
    font-weight: 600;
    font-size: 24px;
    line-height: 140%;
    display: flex;
    align-items: center;
    letter-spacing: -0.02em;
    color: #e6a523;
    margin: 0;
  }

  p {
    position: absolute;
    width: 412px;
    height: 81px;
    left: 64px;
    top: 211px;
    font-family: "Roboto", sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 170%;
    display: flex;
    align-items: center;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0;
  }

  /* Pagination */
  .pagination {
    margin: 60px 0 100px;
    display: flex;
    gap: 6px;
    justify-content: center;
    align-items: center;
  }

  .page-control,
  .page-num {
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border: 1px solid #e9e9e9;
    font-family: "Roboto", sans-serif;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
    user-select: none;
    outline: none;
    padding: 0;
  }

  .page-control {
    padding: 8px 12px;
    gap: 4px;
    color: #1b1b1b;
  }

  .page-num {
    width: 35px;
    color: #313131;
  }

  .page-num.active {
    background: #e6a523;
    border-color: #e6a523;
    color: #121212;
    font-weight: 600;
  }

  .page-num:hover:not(.active),
  .page-control:hover {
    background: #f5f5f5;
  }

  /* Responsive */
  @media (max-width: 1200px) {
    .grid-container {
      padding: 0 20px;
    }
    .row-mix-1-2 .banner,
    .row-mix-2-1 .banner {
      flex: 1;
    }
  }

  @media (max-width: 768px) {
    .row {
      flex-direction: column;
      height: auto;
    }
    .banner {
      height: 324px;
      flex: none !important;
      width: 100% !important;
    }
    .content {
      max-width: 100%;
    }
    .pagination {
      flex-wrap: wrap;
      padding: 0 20px;
    }
    h4 {
      width: calc(100% - 64px);
      font-size: 20px;
    }
    p {
      width: calc(100% - 96px);
      font-size: 14px;
      top: auto;
      bottom: 32px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const galleryGridSection = document.querySelector('.gallery-grid') as HTMLElement;

    if (galleryGridSection) {
      let ticking = false;

      function updateAnimation() {
        const rect = galleryGridSection.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        
        let progress = 1 - (rect.top / windowHeight);
        progress = Math.max(0, Math.min(progress, 1));
        
        if (progress >= 1) {
          galleryGridSection.style.transform = 'none';
        } else {
          const scale = 0.96 + (progress * 0.04);
          galleryGridSection.style.transform = `scale(${scale})`;
        }
        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(updateAnimation);
          ticking = true;
        }
      }, { passive: true });

      updateAnimation();
    }
  });
</script>
