          {
            projects.slice(8, 10).map((p) => (
              <div
                class={`banner project-trigger ${
                  p.size === "xl" ? "banner-xl" : ""
                }`}
                data-project={JSON.stringify(p)}
              >
                <div class="banner-bg" style={`background-image: url(${p.image})`} />
                <div class="overlay" />
                <div class="content">
                  <h4>{p.title}</h4>
                  <p>{p.location}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="page" data-page="2">
        <div class="coming-soon">
          <h2>Coming Soon</h2>
          <p>New projects are on the way. Stay tuned!</p>
        </div>
      </div>

      <div class="page" data-page="3">
