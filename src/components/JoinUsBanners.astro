---
---
<section class="banners-section">
  <div class="banner projects-banner">
    <div class="content">
      <h2>See the Work You'll<br/>Be Part Of</h2>
      <a href="/gallery" class="btn">
        <span>VIEW PROJECTS</span>
      </a>
    </div>
  </div>
  <div class="banner team-banner">
    <div class="content">
      <h2>Meet the People<br/>Behind the Work</h2>
      <a href="/our-team" class="btn">
        <span>MEET OUR TEAM</span>
      </a>
    </div>
  </div>
</section>

<style>
  .banners-section {
    display: flex;
    width: 100%;
    height: 600px;
  }

  .banner {
    flex: 1;
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: 100px;
  }

  .projects-banner {
    background: linear-gradient(180deg, rgba(18, 18, 18, 0) -23.9%, #121212 100%), 
                url('/join-us-projects.png') center/cover no-repeat;
  }

  .team-banner {
    background: linear-gradient(180deg, rgba(18, 18, 18, 0) -23.9%, #121212 100%), 
                url('/join-us-hero.png') center/cover no-repeat;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 32px;
    position: relative;
    z-index: 1;
    max-width: 568px;
  }

  h2 {
    font-family: 'Roboto', sans-serif !important;
    font-style: normal;
    font-weight: 600;
    font-size: 48px;
    line-height: 130%;
    letter-spacing: -0.03em;
    color: #F5F4F4;
    margin: 0;
  }

  .btn {
    box-sizing: border-box;
    display: inline-flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 18px 32px;
    width: fit-content;
    height: 67px;
    border: 1px solid #E6A523;
    border-radius: 7.5px;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    z-index: 1;
    color: #E6A523;
  }
  
  .btn span {
    font-family: 'Roboto', sans-serif;
    font-style: normal;
    font-weight: 600;
    font-size: 18px;
    line-height: 170%;
    transition: color 0.3s ease;
  }

  .btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0%;
    height: 100%;
    background: #E6A523;
    z-index: -1;
    transition: width 0.3s ease;
  }

  .btn:hover::before {
    width: 100%;
  }

  .btn:hover span {
    color: #2E2107;
  }

  @media (max-width: 1024px) {
    .banner {
      padding: 60px 40px;
    }
  }

  @media (max-width: 768px) {
    .banners-section {
      flex-direction: column;
      height: auto;
    }
    .banner {
      height: 400px;
      padding: 40px 20px;
    }
    h2 {
      font-size: 32px;
    }
  }
</style>
