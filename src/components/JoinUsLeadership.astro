---
---
<section class="leadership-section">
  <div class="gallery-container">
    <div class="image-gallery">
      <div class="img-wrapper">
        <img src="/slider/slider_0.png" alt="Leadership opportunity 1" />
      </div>
      <div class="img-wrapper">
        <img src="/slider/slider_1.png" alt="Leadership opportunity 2" />
      </div>
      <div class="img-wrapper">
        <img src="/slider/slider_2.png" alt="Leadership opportunity 3" />
      </div>
    </div>
  </div>
  <div class="container" data-reveal>
    <div class="header">
      <h2>Leadership<br/><span class="highlight">Opportunities</span></h2>
    </div>
    <div class="positions">
      <div class="position">
        <h3>Superintendent</h3>
        <p>Lead field operations, coordinate trades, maintain safety, quality, and schedule, and serve as the primary point of execution for Avonce's integrated scopes.</p>
        <div class="links">
          <a href="#" class="link" onclick="event.preventDefault(); window.openJoinUsModal();"><span>More details</span> <span class="arrow">&rarr;</span></a>
          <a href="#" class="link"><span>Apply now</span> <span class="arrow">&rarr;</span></a>
        </div>
      </div>
      <div class="divider"></div>
      <div class="position">
        <h3>Assistant Superintendent</h3>
        <p>Support field leadership, manage daily site activities, quality control, safety, and coordination across framing, drywall, and exterior scopes.</p>
        <div class="links">
          <a href="#" class="link" onclick="event.preventDefault(); window.openJoinUsModal();"><span>More details</span> <span class="arrow">&rarr;</span></a>
          <a href="#" class="link"><span>Apply now</span> <span class="arrow">&rarr;</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .leadership-section {
    width: 100%;
    background: #121212;
    padding-bottom: 150px;
    transform: scale(0.96);
    transform-origin: center top;
    will-change: transform;
  }

  .gallery-container {
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: 0 100px;
    margin-top: -150px;
    margin-bottom: 120px;
  }

  .image-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .img-wrapper {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .container {
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: 0 100px;
    display: flex;
    justify-content: center;
    gap: 150px;
    align-items: flex-start;
  }

  .header {
    flex: 0 0 auto;
  }

  h2 {
    font-family: 'Roboto', sans-serif !important;
    font-style: normal;
    font-weight: 600;
    font-size: 48px;
    line-height: 130%;
    letter-spacing: -0.03em;
    color: #FCFCFC;
    margin: 0;
  }

  .highlight {
    color: #E6A523;
  }

  .positions {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 432px;
    margin-top: 109px;
  }

  .position {
    display: flex;
    flex-direction: column;
  }

  h3 {
    font-family: 'Roboto', sans-serif !important;
    font-style: normal;
    font-weight: 600;
    font-size: 32px;
    line-height: 140%;
    letter-spacing: -0.03em;
    color: #E6A523;
    margin: 0 0 4px 0;
  }

  p {
    font-family: 'Roboto', sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 18px;
    line-height: 170%;
    letter-spacing: -0.02em;
    color: #F5F4F4;
    margin: 0;
  }

  .links {
    display: flex;
    gap: 16px;
    margin-top: 12px;
  }

  .link {
    display: flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    color: #E6A523;
    transition: opacity 0.3s ease;
  }
  
  .link:hover {
    opacity: 0.8;
  }

  .link span:first-child {
    font-family: 'Roboto', sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 170%;
    letter-spacing: -0.02em;
    text-decoration-line: underline;
  }

  .arrow {
    font-family: 'Roboto', sans-serif;
    font-style: normal;
    font-weight: 500;
    font-size: 20px;
    line-height: 150%;
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .divider {
    width: 100%;
    height: 2px;
    background: #303030;
    margin: 16px 0;
  }

  @media (max-width: 1024px) {
    .container, .gallery-container {
      padding: 0 40px;
    }
    .container {
      gap: 60px;
    }
  }

  @media (max-width: 768px) {
    .container, .gallery-container {
      padding: 0 20px;
    }
    .container {
      flex-direction: column;
      gap: 40px;
    }
    .image-gallery {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .gallery-container {
      margin-top: -80px;
      margin-bottom: 60px;
    }
    .positions {
      margin-top: 0;
    }
    h2 {
      font-size: 32px;
    }
    h3 {
      font-size: 24px;
    }
    p {
      font-size: 16px;
    }
    .leadership-section {
      padding: 80px 0;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const section = document.querySelector('.leadership-section') as HTMLElement;
    if (!section) return;

    let ticking = false;

    function updateAnimation() {
      const rect = section.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      
      let progress = 1 - (rect.top / windowHeight);
      progress = Math.max(0, Math.min(progress, 1));
      
      if (progress >= 1) {
        section.style.transform = 'none';
      } else {
        const scale = 0.96 + (progress * 0.04);
        section.style.transform = `scale(${scale})`;
      }
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateAnimation);
        ticking = true;
      }
    }, { passive: true });

    updateAnimation();
  });
</script>
