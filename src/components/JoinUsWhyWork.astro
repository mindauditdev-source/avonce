---

<section class="why-work-section">
  <div class="container">
    <div class="content">
      <h2>Why Work Here</h2>
      <p>
        At Avonce, we don't just build projects - we build careers. Our teams
        deliver complex multifamily and commercial construction through
        integrated scopes, precise coordination, and pride in craftsmanship. We
        value field leadership, accountability, and a hands-on approach that
        supports professional growth at every level.
      </p>
    </div>
  </div>
</section>

<style>
  .why-work-section {
    width: 100%;
    height: 484px;
    background: #303030;
    display: flex;
    align-items: center;
    padding-bottom: 150px;
    transform: scale(0.96);
    transform-origin: center top;
    will-change: transform;
  }

  .container {
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: 0 100px;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 33px;
    max-width: 884px;
    opacity: 0;
    transform: translateY(4vh);
    will-change: opacity, transform;
  }

  h2 {
    font-family: "Roboto", sans-serif !important;
    font-style: normal;
    font-weight: 600;
    font-size: 48px;
    line-height: 130%;
    letter-spacing: -0.03em;
    color: #fcfcfc;
    margin: 0;
  }

  p {
    font-family: "Roboto", sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 18px;
    line-height: 170%;
    letter-spacing: -0.02em;
    color: #fcfcfc;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .container {
      padding: 0 40px;
    }
  }

  @media (max-width: 768px) {
    .why-work-section {
      height: auto;
      padding: 80px 0;
    }
    .container {
      padding: 0 20px;
    }
    h2 {
      font-size: 32px;
    }
    p {
      font-size: 16px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const section = document.querySelector('.why-work-section') as HTMLElement;
    const content = document.querySelector('.why-work-section .content') as HTMLElement;

    if (section && content) {
      let ticking = false;

      function updateAnimation() {
        const rect = section.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        
        let progress = 1 - (rect.top / windowHeight);
        progress = Math.max(0, Math.min(progress, 1));
        
        if (progress >= 1) {
          section.style.transform = 'none';
        } else {
          const scale = 0.96 + (progress * 0.04);
          section.style.transform = `scale(${scale})`;
        }
        
        const opacity = progress; 
        const yOffset = (1 - progress) * 4;
        
        content.style.opacity = opacity.toString();
        content.style.transform = `translateY(${yOffset}vh)`;
        
        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(updateAnimation);
          ticking = true;
        }
      }, { passive: true });

      updateAnimation();
    }
  });
</script>
