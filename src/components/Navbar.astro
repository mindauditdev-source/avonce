<style>
  .navbar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 96px;
    display: flex;
    align-items: center;
    z-index: 100;
    background: transparent;
    transition: background 0.3s ease;
  }

  .navbar:hover {
    background: #e6a523;
  }

  .navbar:hover .nav-link {
    color: #2e2107 !important;
  }

  .navbar:hover path {
    fill: #2e2107 !important;
  }

  .navbar-light {
    background: #fcfcfc;
  }

  .navbar-primary {
    background: #e6a523;
  }

  .navbar-primary .nav-link {
    color: #2e2107 !important;
  }

  .navbar-primary path {
    fill: #2e2107 !important;
  }

  .navbar-primary text {
    fill: #2e2107 !important;
  }

  .navbar-light .nav-link {
    color: #1b1b1b !important;
  }

  .container {
    max-width: 1440px;
    width: 100%;
    height: 100%;
    margin: 0 auto;
    padding: 0 100px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo a {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo path {
    transition: fill 0.3s ease;
  }

  .nav-links {
    display: flex;
    gap: 28px;
    align-items: center;
    height: 100%;
  }

  .mobile-menu-toggle {
    display: none;
  }

  .mobile-dropdown {
    display: none;
  }

  .nav-item {
    height: 100%;
  }

  .nav-link {
    font-family: "Roboto", sans-serif;
    font-style: normal;
    font-weight: 600;
    font-size: 16px;
    line-height: 170%;
    text-transform: uppercase;
    color: #ffffff;
    text-decoration: none;
    transition: all 0.3s ease;
    white-space: nowrap;
    opacity: 0.9;
    height: 100%;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 100;
  }

  .nav-link:hover {
    color: #e6a523;
    opacity: 1;
  }

  /* Submenu Hover Triangle (V-notch) */
  .nav-item.has-submenu .nav-link::after {
    content: "";
    position: absolute;
    bottom: -9px; /* Ajuste milimétrico para cubrir el grosor del borde (1px) */
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 16px;
    height: 16px;
    border-bottom: 1px solid #2e2107;
    border-right: 1px solid #2e2107;
    background: #e6a523;
    opacity: 0;
    z-index: 101;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  .nav-item.has-submenu:hover .nav-link::after {
    opacity: 1;
  }

  /* Submenu Container */
  .submenu-container {
    position: absolute;
    top: 96px;
    left: 0;
    width: 100%;
    background: #e6a523;
    border-top: 1px solid #2e2107;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.3s ease;
    padding: 60px 0;
    cursor: default;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    z-index: 99;
  }

  .nav-item.has-submenu:hover .submenu-container {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .submenu-inner.v2 {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 100px;
    display: flex;
    justify-content: flex-end;
    gap: 60px;
  }

  .highlight-item.v2 {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    width: 319px;
  }

  .highlight-item.v2 .image {
    width: 319px;
    height: 248px;
    overflow: hidden;
    margin-bottom: 0;
  }

  .highlight-item.v2 .image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .highlight-item.v2:hover .image img {
    transform: scale(1.05);
  }

  .highlight-item.v2 .title {
    font-family: "Roboto", sans-serif;
    font-weight: 500;
    font-size: 20px;
    line-height: 150%;
    color: #000000;
    margin-top: 16px;
    margin-bottom: 4px;
    transition: color 0.3s ease;
  }

  .highlight-item.v2 .description {
    font-family: "Roboto", sans-serif;
    font-weight: 400;
    font-size: 12px;
    line-height: 170%;
    color: #000000;
  }

  .other.v2 {
    display: flex;
    flex-direction: column;
    margin-left: 20px; /* Optional spacing adjustment */
  }

  .other-heading {
    font-family: "Roboto", sans-serif;
    font-weight: 700;
    font-size: 16px;
    color: #2e2107;
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .other-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .other-list a {
    font-family: "Roboto", sans-serif;
    font-weight: 400;
    font-size: 16px;
    color: #2e2107;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .other-list a:hover {
    opacity: 0.6;
  }

  @media (max-width: 1024px) {
    .container {
      padding: 0 40px;
    }
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }

    .container {
      padding: 0 20px;
    }

    .navbar {
      height: 50px;
    }

    .logo svg {
      width: 131.4px;
      height: 18px;
    }

    .mobile-menu-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: none;
      cursor: pointer;
      padding: 0;
      color: #ffffff;
      z-index: 1001;
    }

    .navbar-light .mobile-menu-toggle {
      color: #1b1b1b;
    }

    .mobile-menu-toggle svg {
      display: none;
    }

    .mobile-menu-toggle .icon-burger {
      display: block;
    }

    .mobile-dropdown {
      position: fixed;
      top: 50px;
      left: 0;
      width: 100vw;
      height: calc(100vh - 50px);
      background: #E6A523;
      z-index: 1000;
      display: none;
      overflow-y: auto;
    }

    :global(body.mobile-menu-open) .mobile-dropdown {
      display: block;
    }

    .dropdown-items {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding: 0;
    }

    .mobile-nav-item {
      border-bottom: 2px solid #EBB74F;
      background: #E6A523;
    }

    .item-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 18px 16px;
      height: 63px;
      box-sizing: border-box;
    }

    .item-header a {
      font-family: 'Roboto', sans-serif;
      font-weight: 600;
      font-size: 16px;
      line-height: 170%;
      text-transform: uppercase;
      color: #2E2107 !important;
      text-decoration: none !important;
    }

    .chevron {
      color: #2E2107;
      transition: transform 0.3s ease;
      flex-shrink: 0;
    }

    .mobile-nav-item.active .chevron {
      transform: rotate(180deg);
    }

    .mobile-submenu {
      display: none;
      background: rgba(46, 33, 7, 0.08);
      flex-direction: column;
    }

    .mobile-nav-item.active .mobile-submenu {
      display: flex;
    }

    .mobile-submenu a {
      padding: 14px 32px;
      font-family: 'Roboto', sans-serif;
      font-weight: 500;
      font-size: 15px;
      color: #2E2107 !important;
      text-decoration: none !important;
      border-bottom: 1px solid rgba(235, 183, 79, 0.4);
    }

    .mobile-submenu a:last-child {
      border-bottom: none;
    }
  }

  /* Global open-state overrides (must be outside @media for Astro :global() to work) */
  @media (max-width: 768px) {
    :global(body.mobile-menu-open) .navbar {
      background: #E6A523 !important;
      border-bottom: 2px solid #2E2107 !important;
      position: fixed !important;
    }

    :global(body.mobile-menu-open) .logo path {
      fill: #2E2107 !important;
    }

    :global(body.mobile-menu-open) .mobile-menu-toggle {
      color: #2E2107 !important;
    }

    :global(body.mobile-menu-open) .icon-burger {
      display: none !important;
    }

    :global(body.mobile-menu-open) .icon-close {
      display: block !important;
    }
  }
</style>

<script>
  function initMobileMenu() {
    const toggle = document.querySelector('.mobile-menu-toggle');
    const body = document.body;
    const itemsWithSubmenu = document.querySelectorAll('.mobile-nav-item.has-submenu');

    if (toggle) {
      toggle.addEventListener('click', () => {
        body.classList.toggle('mobile-menu-open');
        // Prevent scroll when menu is open
        if (body.classList.contains('mobile-menu-open')) {
          body.style.overflow = 'hidden';
        } else {
          body.style.overflow = '';
        }
      });
    }

    itemsWithSubmenu.forEach(item => {
      const header = item.querySelector('.item-header');
      const chevron = item.querySelector('.chevron');
      
      if (header && chevron) {
        chevron.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          item.classList.toggle('active');
        });
      }
    });
  }

  // Run on initial load
  initMobileMenu();

  // Run on view transition (if using Astro view transitions)
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
