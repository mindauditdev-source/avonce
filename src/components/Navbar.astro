    <div class="nav-links">
      <div class="nav-item has-submenu">
        <a href="/about" class="nav-link">About</a>
        <div class="submenu-container">
          <div class="submenu-inner v2">
            <a href="/about" class="highlight-item v2">
              <div class="image">
                <img src="/about-navbar.png" alt="About Us" />
              </div>
              <span class="title">About Us</span>
              <span class="description"
                >Explore our commitment to safety, quality, and a transparent partnership on every build.</span
              >
            </a>
            <a href="/our-team" class="highlight-item v2">
              <div class="image">
                <img src="/our-team.png" alt="Our Team" />
              </div>
              <span class="title">Our Team</span>
              <span class="description"
                >Meet the experts behind our success - a dedicated group of trade professionals committed to precision and accountability.</span
              >
            </a>
            <div class="other v2">
              <span class="other-heading">Learn More</span>
              <ul class="other-list">
                <li><a href="/about#leadership">Leadership</a></li>
                <li><a href="/about#core-values">Our Core Values</a></li>
