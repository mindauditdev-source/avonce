---
interface Props {
  light?: boolean;
  primary?: boolean;
}

const { light = false, primary = false } = Astro.props;
---
<nav class={`navbar ${light ? 'navbar-light' : ''} ${primary ? 'navbar-primary' : ''}`}>
  <div class="container">
    <div class="logo">
      <a href="/">
        <svg width="234" height="40" viewBox="0 0 234 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Stylized A (Roof shape from Figma) -->
          <path d="M5 20L20 5L35 20V35H28V22H12V35H5V20Z" fill="#E6A523"/>
          <path d="M12 22H28V24H12V22Z" fill="#E6A523" opacity="0.5"/>
          
          <!-- Text "VONCE" in a bold, clean style -->
          <text x="45" y="32" fill="#E6A523" style="font-family: 'Roboto', sans-serif; font-weight: 700; font-size: 32px; letter-spacing: -0.02em;">VONCE</text>
        </svg>
      </a>
    </div>

    <div class="nav-links">
      <a href="/about" class="nav-link">About</a>
      <a href="/services" class="nav-link">Expertise</a>
      <a href="/gallery" class="nav-link">Gallery</a>
      <a href="/our-team" class="nav-link">Join our team</a>
      <a href="/contact" class="nav-link">Contact</a>
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 96px;
    display: flex;
    align-items: center;
    z-index: 100;
    background: transparent;
  }

  .navbar-light {
    background: #FCFCFC;
  }

  .navbar-primary {
    background: #E6A523;
  }

  .navbar-primary .nav-link {
    color: #2E2107 !important;
  }

  .navbar-primary path {
    fill: #2E2107 !important;
  }

  .navbar-primary text {
    fill: #2E2107 !important;
  }

  .navbar-light .nav-link {
    color: #1B1B1B !important;
  }

  .container {
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: 0 100px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo a {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 28px;
    align-items: center;
  }

  .nav-link {
    font-family: 'Roboto', sans-serif;
    font-style: normal;
    font-weight: 600;
    font-size: 16px;
    line-height: 170%;
    text-transform: uppercase;
    color: #FFFFFF;
    text-decoration: none;
    transition: all 0.3s ease;
    white-space: nowrap;
    opacity: 0.9;
  }

  .nav-link:hover {
    color: #E6A523;
    opacity: 1;
    transform: translateY(-1px);
  }

  @media (max-width: 1024px) {
    .container {
      padding: 0 40px;
    }
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }
    .container {
      padding: 0 20px;
    }
  }
</style>
