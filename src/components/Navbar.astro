      <div class="mobile-nav-item">
        <div class="item-header">
          <a href="/blog">BLOG</a>
        </div>
      </div>
      <div class="mobile-nav-item">
        <div class="item-header">
          <a href="/contact">CONTACT</a>
        </div>
      </div>
