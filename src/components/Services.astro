<section id="services" class="services-section">
  <!-- Vector Background (Dark Shape) -->
  <div class="vector-bg"></div>

  <div class="container text-container">
    <div class="text-content" data-reveal>
      <span class="subtle">OUR SERVICES</span>
      <h2 class="heading">Thorough Preparation.<br />Precise Execution</h2>

      <div class="description">
        <p class="highlight">
          At Avonce Construction Group, we believe in thorough project
          preparation.
        </p>
        <p>
          Our process begins with an in-depth analysis of project plans,
          specifications, submittals, and compliance requirements (such as
          FHA/ADA standards). This stage allows us to proactively address
          inconsistencies and gather all necessary information for seamless
          project execution.
        </p>
        <p>
          We create custom shop drawings to ensure clarity and precision for
          every project, tailored specifically to our scope of work.
        </p>
      </div>

      <a href="/services" class="btn-primary">
        <span class="btn-label">VIEW OUR SERVICES</span>
        <div class="bg-effect"></div>
      </a>
    </div>
  </div>

  <!-- Bottom Column: Sticky Horizontal Slider -->
  <div class="slider-pin-spacer">
    <div class="slider-wrapper">
      <div class="slider-track" id="services-slider">
      <!-- Card 1: Bottom Text -->
      <div class="slide card-bottom">
        <div class="slide-img">
          <div class="img-overlay"></div>
          <img
            src="/slider/slider_0.png"
            alt="Slider Image 1"
            draggable="false"
          />
        </div>
        <div class="slide-content">
          <div class="divider"></div>
          <div class="info">
            <h3 class="slide-title">Rough Framing</h3>
            <p class="slide-text">
              This is mock description text for the first card. It will be
              replaced later.
            </p>
          </div>
        </div>
      </div>

      <!-- Card 2: Top Text -->
      <div class="slide card-top">
        <div class="slide-img">
          <div class="img-overlay"></div>
          <img
            src="/slider/slider_1.png"
            alt="Slider Image 2"
            draggable="false"
          />
        </div>
        <div class="slide-content">
          <div class="divider"></div>
          <div class="info">
            <h3 class="slide-title">Exterior</h3>
            <p class="slide-text">
              This is mock description text for the second card. It will be
              replaced later.
            </p>
          </div>
        </div>
      </div>

      <!-- Card 3: Bottom Text -->
      <div class="slide card-bottom">
        <div class="slide-img">
          <div class="img-overlay"></div>
          <img
            src="/slider/slider_2.png"
            alt="Slider Image 3"
            draggable="false"
          />
        </div>
        <div class="slide-content">
          <div class="divider"></div>
          <div class="info">
            <h3 class="slide-title">Drywall</h3>
            <p class="slide-text">
              This is mock description text for the third card. It will be
              replaced later.
            </p>
          </div>
        </div>
      </div>

      <!-- Card 4: Top Text -->
      <div class="slide card-top">
        <div class="slide-img">
          <div class="img-overlay"></div>
          <img
            src="/slider/slider_3.png"
            alt="Slider Image 4"
            draggable="false"
          />
        </div>
        <div class="slide-content">
          <div class="divider"></div>
          <div class="info">
            <h3 class="slide-title">Commercial</h3>
            <p class="slide-text">
              This is mock description text for the fourth card. It will be
              replaced later.
            </p>
          </div>
        </div>
      </div>

      <!-- Card 5: Bottom Text -->
      <div class="slide card-bottom">
        <div class="slide-img">
          <div class="img-overlay"></div>
          <img
            src="/slider/slider_4.png"
            alt="Slider Image 5"
            draggable="false"
          />
        </div>
        <div class="slide-content">
          <div class="divider"></div>
          <div class="info">
            <h3 class="slide-title">Other Services</h3>
            <p class="slide-text">
              This is mock description text for the fifth card. It will be
              replaced later.
            </p>
          </div>
        </div>
      </div>

      <!-- Card 6: Gallery CTA -->
      <a href="/gallery" class="slide card-gallery-cta">
        <div class="slide-img">
          <img
            src="/slider/slider_0.png"
            alt="See Project Gallery"
            draggable="false"
          />
          <div class="gallery-cta-overlay"></div>
          <div class="gallery-cta-label">
            <span>See</span>
            <span>Project</span>
            <span>Gallery</span>
          </div>
        </div>
      </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .services-section {
    position: relative;
    background: #121212;
    padding: 160px 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    transform: scale(0.96);
    transform-origin: center top;
  }

  .vector-bg {
    position: absolute;
    width: 656px;
    height: 488px;
    right: 0;
    bottom: -100px;
    background: #06090c;
    z-index: 0;
    clip-path: polygon(0 40%, 50% 0, 100% 40%, 100% 100%, 0 100%);
  }

  .container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 100px;
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .text-container {
    display: flex;
    justify-content: center;
  }

  .text-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
    max-width: 884px;
    width: 100%;
  }

  .subtle {
    font-family: "Roboto", sans-serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 170%;
    color: #e6a523;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .heading {
    font-family: "Roboto", sans-serif;
    font-weight: 600;
    font-size: clamp(32px, 4vw, 48px);
    line-height: 130%;
    letter-spacing: -0.03em;
    color: #f5f4f4;
    margin: 0;
  }

  .description {
    display: flex;
    flex-direction: column;
    gap: 24px;
    font-family: "Roboto", sans-serif;
    font-size: 18px;
    line-height: 170%;
    color: #f5f4f4;
  }

  .description p {
    margin: 0;
  }

  .description .highlight {
    font-weight: 600;
  }

  .btn-primary {
    position: relative;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 18px 32px;
    border: 1px solid #e6a523;
    border-radius: 7.5px;
    text-decoration: none;
    overflow: hidden;
    transition: all 0.3s ease;
    margin-top: 16px;
  }

  .btn-label {
    position: relative;
    z-index: 1;
    font-family: "Roboto", sans-serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 170%;
    color: #e6a523;
    transition: color 0.3s ease;
  }

  .bg-effect {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 100%;
    background: #e6a523;
    z-index: 0;
    transition: width 0.3s ease;
  }

  @media (hover: hover) {
    .btn-primary:hover .bg-effect {
      width: 100%;
    }

    .btn-primary:hover .btn-label {
      color: #121212;
    }
  }

  /* Slider Styles */
  .slider-pin-spacer {
    position: relative;
    width: 100%;
    height: 300vh; /* Controla qué tan largo es el scroll para ver todas las tarjetas */
  }

  .slider-wrapper {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    z-index: 1;
  }

  .slider-track {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 0 100px 0 calc(50vw - 442px);
    will-change: transform;
  }

  .slide {
    position: relative;
    flex: 0 0 640px;
    user-select: none;
    transform: translateZ(0);
  }

  .slide-img {
    width: 100%;
    /* Mantenemos el height automático para que la imagen se vea completa */
    position: relative;
    overflow: hidden;
    border-radius: 8px;
  }

  .img-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      180deg,
      rgba(18, 18, 18, 0) 0%,
      rgba(18, 18, 18, 0.2) 100%
    );
    z-index: 1;
    pointer-events: none;
  }

  .slide-img img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
    transition: transform 0.5s ease;
    z-index: 0;
    pointer-events: none;
    backface-visibility: hidden;
  }

  .slide:hover .slide-img img {
    transform: scale(1.05);
  }

  /* Card Content (Text and Divider) */
  .slide-content {
    display: flex;
    position: absolute;
    left: 127px;
    width: 386px;
    z-index: 2;
    pointer-events: none;
  }

  /* Gallery CTA Card */
  .card-gallery-cta {
    text-decoration: none;
    cursor: pointer;
    display: block;
    position: relative;
  }

  .card-gallery-cta .slide-img {
    position: relative;
  }

  .gallery-cta-overlay {
    position: absolute;
    inset: 0;
    background: rgba(18, 18, 18, 0.58);
    border-radius: 8px;
    z-index: 1;
    transition: background 0.4s ease;
    pointer-events: none;
  }

  .card-gallery-cta:hover .gallery-cta-overlay {
    background: rgba(18, 18, 18, 0.42);
  }

  .gallery-cta-label {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    gap: 0;
  }

  .gallery-cta-label span {
    font-family: 'Roboto', sans-serif;
    font-weight: 600;
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #e6a523;
    display: block;
    text-align: center;
    transition: transform 0.4s ease;
  }

  .card-gallery-cta:hover .gallery-cta-label span {
    transform: scale(1.04);
  }

  .divider {
    width: 4px;
    height: 76px;
    background: #e6a523;
    flex-shrink: 0;
  }

  .info {
    display: flex;
    flex-direction: column;
    width: 366px;
  }

  .slide-title {
    font-family: "Roboto", sans-serif;
    font-weight: 600;
    font-size: 32px;
    line-height: 140%;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0 0 4px 0;
  }

  .slide-text {
    font-family: "Roboto", sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 170%;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0;
  }

  /* Bottom Text Modifiers */
  .card-bottom .slide-content {
    flex-direction: row;
    align-items: flex-start;
    gap: 16px;
    bottom: -100px;
  }

  .card-bottom .info {
    padding-top: 44px;
  }

  /* Top Text Modifiers */
  .card-top .slide-content {
    flex-direction: row;
    align-items: flex-end;
    gap: 16px;
    top: -107px;
  }

  .card-top .info {
    padding-bottom: 44px;
  }

  @media (max-width: 1024px) {
    .slide {
      flex: 0 0 500px;
      display: flex;
      flex-direction: column;
    }
    .slide-content {
      position: static;
      flex-direction: row;
      align-items: flex-start;
      gap: 16px;
      width: 100%;
      margin-top: 16px;
      left: auto;
      pointer-events: auto;
    }
    .divider {
      height: auto;
      min-height: 40px;
      align-self: stretch;
    }
    .info {
      flex: 1;
      width: 100%;
    }
    .card-bottom .slide-content,
    .card-top .slide-content {
      top: auto;
      bottom: auto;
    }
    .card-bottom .info,
    .card-top .info {
      padding: 0;
    }
    .slide-title {
      font-size: 24px;
    }
    .container {
      padding: 0 40px;
    }
    .slider-track {
      padding-left: max(40px, calc(50vw - 442px));
    }
  }

  @media (max-width: 768px) {
    .slide {
      flex: 0 0 300px;
    }
    .slide-content {
      margin-top: 12px;
    }
    .vector-bg {
      width: 120px;
      height: 89px;
      right: auto;
      left: 50%;
      transform: translateX(-50%);
      top: calc(80px + 50vh);
      bottom: auto;
    }
    .services-section {
      padding-top: 80px;
    }
    .container {
      padding: 0 20px;
    }
    .slider-track {
      padding-left: 20px;
      gap: 16px;
      padding-top: 80px;
      padding-bottom: 80px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Scroll animation for Services section (Scale only)
    const servicesSection = document.querySelector('.services-section') as HTMLElement;

    if (servicesSection) {
      let tickingScroll = false;
      function updateServicesScale() {
        const rect = servicesSection.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        
        let progress = 1 - (rect.top / windowHeight);
        progress = Math.max(0, Math.min(progress, 1));
        
        if (progress >= 1) {
          servicesSection.style.transform = 'none';
        } else {
          const scale = 0.96 + (progress * 0.04);
          servicesSection.style.transform = `scale(${scale})`;
        }
        tickingScroll = false;
      }
      
      updateServicesScale();
      
      window.addEventListener('scroll', () => {
        if (!tickingScroll) {
          window.requestAnimationFrame(updateServicesScale);
          tickingScroll = true;
        }
      }, { passive: true });
    }

    // Sticky Horizontal Scroll for Slider
    const pinSpacer = document.querySelector('.slider-pin-spacer') as HTMLElement;
    const sliderTrack = document.getElementById("services-slider") as HTMLElement;

    if (pinSpacer && sliderTrack) {
      let tickingSlider = false;
      
      function updateSliderScroll() {
        const rect = pinSpacer.getBoundingClientRect();
        // Calculate how far we've scrolled into the pin spacer
        const scrollDistance = rect.height - window.innerHeight;
        let scrolled = -rect.top;
        
        // Normalize progress between 0 and 1
        let progress = scrolled / scrollDistance;
        progress = Math.max(0, Math.min(progress, 1));
        
        // Calculate max horizontal translate
        const trackScrollWidth = sliderTrack.scrollWidth;
        const maxTranslate = trackScrollWidth - window.innerWidth;
        
        const translateX = progress * maxTranslate;
        sliderTrack.style.transform = `translate3d(${-translateX}px, 0, 0)`;
        
        tickingSlider = false;
      }
      
      // Initialize state
      updateSliderScroll();
      
      window.addEventListener('scroll', () => {
        if (!tickingSlider) {
          window.requestAnimationFrame(updateSliderScroll);
          tickingSlider = true;
        }
      }, { passive: true });
    }
  });
</script>
