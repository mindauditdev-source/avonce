---
// src/components/ServicesApproach.astro
---

<section class="services-approach">
  <div class="container">
    <h2 class="heading">Our Integrated Approach</h2>
    
    <div class="approach-grid">
      <div class="column">
        <ul>
          <li>Integrated Trade Management</li>
          <li>Material & Logistics Control</li>
        </ul>
      </div>
      <div class="column">
        <ul>
          <li>Field Supervision & Quality Assurance</li>
          <li>Schedule & Safety Coordination</li>
        </ul>
      </div>
      <div class="column">
        <ul>
          <li>Single-Source Accountability</li>
          <li>End-to-End Scope Delivery</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .services-approach {
    width: 100%;
    height: 300px;
    background: #FCFCFC;
    display: flex;
    align-items: center;
    overflow: hidden;
    transform: scale(0.96);
    transform-origin: center top;
    will-change: transform;
  }

  .container {
    max-width: 1536px;
    width: 100%;
    margin: 0 auto;
    padding: 0 326px; /* Matching the left: 326px from provided styles */
    display: flex;
    flex-direction: column;
    gap: 32px;
    opacity: 0;
    transform: translateY(4vh);
    will-change: opacity, transform;
  }

  .heading {
    font-family: 'Roboto', sans-serif;
    font-style: normal;
    font-weight: 600;
    font-size: 48px;
    line-height: 130%;
    letter-spacing: -0.03em;
    color: #E6A523;
    margin: 0;
  }

  .approach-grid {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 32px;
    width: 100%;
  }

  .column {
    flex: 1;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  li {
    font-family: 'Roboto', sans-serif;
    font-style: normal;
    font-weight: 600;
    font-size: 18px;
    line-height: 1.2;
    color: #1B1B1B;
    position: relative;
    padding-left: 16px;
    display: flex;
    align-items: center;
  }

  li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: #1B1B1B;
    font-size: 20px;
  }

  /* Responsive Adjustments */
  @media (max-width: 1440px) {
    .container {
      padding: 0 100px;
    }
  }

  @media (max-width: 1024px) {
    .services-approach {
      height: auto;
      padding: 60px 0;
    }
    .approach-grid {
      flex-direction: column;
      gap: 24px;
    }
    .heading {
      font-size: 36px;
    }
  }
  @media (max-width: 768px) {
    .heading {
      font-size: 32px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const approachSection = document.querySelector('.services-approach') as HTMLElement;
    const container = document.querySelector('.services-approach .container') as HTMLElement;

    if (approachSection && container) {
      let ticking = false;

      function updateAnimation() {
        const rect = approachSection.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        
        let progress = 1 - (rect.top / windowHeight);
        progress = Math.max(0, Math.min(progress, 1));
        
        if (progress >= 1) {
          approachSection.style.transform = 'none';
        } else {
          const scale = 0.96 + (progress * 0.04);
          approachSection.style.transform = `scale(${scale})`;
        }
        
        const opacity = progress; 
        const yOffset = (1 - progress) * 4;
        
        container.style.opacity = opacity.toString();
        container.style.transform = `translateY(${yOffset}vh)`;
        
        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(updateAnimation);
          ticking = true;
        }
      }, { passive: true });

      updateAnimation();
    }
  });
</script>
