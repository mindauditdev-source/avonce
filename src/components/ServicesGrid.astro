---
// src/components/ServicesGrid.astro
---

<section class="services-grid">
  <div class="grid-container">
    <!-- Row 1 -->
    <div class="banner-row">
      <div class="banner xl turnkey">
        <h4 class="banner-title">Turnkey Wood And Metal Framing</h4>
        <p class="banner-text">
          Complete structural framing solutions including labor and turnkey supply of lumber, metal framing, trusses, and hardware, ensuring coordination and reliable project performance.
        </p>
      </div>
      <div class="banner firewall">
        <h4 class="banner-title">Firewall Assemblies</h4>
        <p class="banner-text">
          Professional installation of window and exterior door systems with proper integration into the building envelope and flashing systems.
        </p>
      </div>
    </div>

    <!-- Row 2 -->
    <div class="banner-row">
      <div class="banner cabinets">
        <h4 class="banner-title">Cabinets And Countertops</h4>
        <p class="banner-text">
          Supply and installation of cabinets, countertops, and sinks, coordinated with adjacent trades to ensure proper fit, quality execution, and seamless final results.
        </p>
      </div>
      <div class="banner xl finishing">
        <h4 class="banner-title">Interior Finishing</h4>
        <p class="banner-text">
          Comprehensive interior scope including insulation, drywall, and painting, coordinated to ensure proper sequencing, quality control, and consistent, well-executed project finishes.
        </p>
      </div>
    </div>

    <!-- Row 3 -->
    <div class="banner-row">
      <div class="banner xl cladding">
        <h4 class="banner-title">Exterior Cladding Systems</h4>
        <p class="banner-text">
          High bonding capacity for building envelope scopes including stucco, siding, and stone, etc. ensuring integration, durability, weatherproofing, and consistent performance.
        </p>
      </div>
      <div class="banner windows">
        <h4 class="banner-title">Windows And Patio Doors Installation</h4>
        <p class="banner-text">
          Supply of windows and installation of windows and patio doors, coordinated with the building envelope to ensure proper fit, performance, and durability.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .services-grid {
    width: 100%;
    background: #FCFCFC;
    padding: 6px 0;
    overflow: hidden;
  }

  .grid-container {
    max-width: 1536px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .banner-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 6px;
    height: 324px;
    width: 100%;
  }

  .banner {
    position: relative;
    height: 100%;
    flex: 0 0 508px;
    background-size: cover;
    background-position: center;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 32px;
  }

  .banner.xl {
    flex: 0 0 1022px;
  }

  .banner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6));
    z-index: 1;
  }

  .banner-title {
    position: relative;
    z-index: 2;
    font-family: 'Roboto', sans-serif;
    font-style: normal;
    font-weight: 600;
    font-size: 24px;
    line-height: 140%;
    letter-spacing: -0.02em;
    color: #E6A523;
    margin: 0;
  }

  .banner-text {
    position: relative;
    z-index: 2;
    font-family: 'Roboto', sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 170%;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    margin: 0;
    max-width: 412px;
    align-self: flex-start;
  }

  .xl .banner-text {
    max-width: 612px;
    align-self: flex-end;
  }

  /* Specific background images */
  /* Using provided filenames, but using fallback colors for visibility if missing */
  .turnkey {
    background-image: url('/wood-framing.png'), 
                      url('/imgi_8_construccion-casas-nuevas-construido-armadura-madera-postes-vigas_73110-5954.jpg'), 
                      linear-gradient(45deg, #1a1a1a, #333);
  }
  .firewall {
    background-image: url('/firewall.png'), 
                      url('/Photo Jan 20 2026, 10 04 56 AM.jpg'), 
                      linear-gradient(45deg, #222, #444);
  }
  .cabinets {
    background-image: url('/cabinets.png'), 
                      url('/imgi_13_instalacion-nivel-armarios-cocina_455891-1111.jpg'), 
                      linear-gradient(45deg, #1a1a1a, #333);
  }
  .finishing {
    background-image: url('/finishing.png'), 
                      url('/Photo Feb 23 2026, 10 47 21 AM.jpg'), 
                      linear-gradient(45deg, #222, #444);
  }
  .cladding {
    background-image: url('/cladding.png'), 
                      url('/DJI_0498.jpg'), 
                      linear-gradient(45deg, #1a1a1a, #333);
  }
  .windows {
    background-image: url('/windows.png'), 
                      url('/Posner-Apartments-Davenport-FL.-Waterproofing-siding-stone.-2021-2022-2-1-1024x768.jpg'), 
                      linear-gradient(45deg, #222, #444);
  }

  /* Responsive Adjustments */
  @media (max-width: 1200px) {
    .banner-row {
      flex-direction: column;
      height: auto;
    }
    .banner, .banner.xl {
      flex: 1 1 auto;
      width: 100%;
      height: 324px;
    }
    .xl .banner-text {
      align-self: flex-start;
    }
  }

  @media (max-width: 768px) {
    .banner {
      padding: 24px;
    }
    .banner-title {
      font-size: 20px;
    }
    .banner-text {
      font-size: 14px;
    }
  }
</style>
