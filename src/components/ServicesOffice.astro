---
// src/components/ServicesOffice.astro
---

<section class="services-office">
  <div class="img-map-bg"></div>

  <div class="content-wrapper">
    <div class="headings" data-reveal>
      <div class="container">
        <div class="frame">
          <span class="subtle">OFFICE LOCATION</span>
          <h2 class="heading">Local Presence.<br />Regional Reach.</h2>
        </div>
      </div>
      <p class="description">
        Our Orlando office supports multifamily and commercial projects across
        Florida with coordinated planning, field supervision, and end-to-end
        scope delivery.
      </p>
    </div>

    <div class="info" data-reveal data-reveal-delay="200">
      <div class="frame-23">
        <div class="frame-26">
          <h3 class="orlando-fl">Orlando, Fl</h3>
          <p class="address">
            8810 Commodity Cir, Suite 29<br />
            Orlando, Fl 32819
          </p>
          <div class="frame-24">
            <div class="phone-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M20 15.5C18.8 15.5 17.6 15.3 16.4 14.9C16.1 14.8 15.7 14.9 15.4 15.2L13.2 17.4C10.4 16 8.1 13.7 6.6 10.8L8.8 8.6C9.1 8.3 9.2 7.9 9.1 7.6C8.7 6.4 8.5 5.2 8.5 4C8.5 3.4 8.1 3 7.5 3H4C3.4 3 3 3.4 3 4C3 13.4 10.6 21 20 21C20.6 21 21 20.6 21 20V16.5C21 15.9 20.6 15.5 20 15.5Z"
                  fill="black"></path>
              </svg>
            </div>
            <span class="phone-number">(407) 270-4808</span>
          </div>
        </div>
        <div class="orlando-map">
          <div class="mini-map-container">
            <div class="map-circle">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2C8.13 2 5 5.13 5 9C5 14.25 12 22 12 22C12 22 19 14.25 19 9C19 5.13 15.87 2 12 2ZM12 11.5C10.62 11.5 9.5 10.38 9.5 9C9.5 7.62 10.62 6.5 12 6.5C13.38 6.5 14.5 7.62 14.5 9C14.5 10.38 13.38 11.5 12 11.5Z" fill="black"></path>
              </svg>
            </div>
            <div class="mini-map-overlay">
              <span class="mini-map-text">Come Visit Us</span>
              <div class="mini-map-icons">
                <a href="https://maps.google.com/?q=8810+Commodity+Cir+Suite+29+Orlando+FL+32819" target="_blank" rel="noopener noreferrer" class="map-nav-link" aria-label="Open in Google Maps" data-map="google">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                </a>
                <a href="https://maps.apple.com/?q=8810+Commodity+Cir+Suite+29+Orlando+FL+32819" target="_blank" rel="noopener noreferrer" class="map-nav-link" aria-label="Open in Apple Maps" data-map="apple">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14l-5-5 1.41-1.41L11 13.17l7.59-7.59L20 7l-9 9z"/></svg>
                </a>
                <a href="https://waze.com/ul?q=8810+Commodity+Cir+Suite+29+Orlando+FL+32819" target="_blank" rel="noopener noreferrer" class="map-nav-link" aria-label="Open in Waze" data-map="waze">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z"/></svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <a href="/contact" class="button-2" data-reveal data-reveal-delay="400">
      <span class="bg-effect"></span>
      <span class="button-label">CONTACT US</span>
    </a>
  </div>
</section>

<style>
  .services-office {
    position: relative;
    width: 100%;
    height: 1024px;
    background: #e6a523;
    overflow: hidden;
  }

  .img-map-bg {
    position: absolute;
    width: 960px;
    height: 734px;
    left: calc(50% - 960px / 2 + 280px);
    top: calc(50% - 734px / 2 + 20px);
    background: url("/map-stroke.png");
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    opacity: 0.2; /* Subtle stroke visibility */
    pointer-events: none;
    mix-blend-mode: multiply; /* Removes white background and blends stroke with yellow */
  }

  .content-wrapper {
    max-width: 1440px;
    margin: 0 auto;
    position: relative;
    height: 100%;
  }

  /* Headings Section */
  .headings {
    position: absolute;
    width: 432px;
    height: 312px;
    left: 120px;
    top: 149px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
  }

  .container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0;
    gap: 64px;
    width: 432px;
    height: 187px;
  }

  .frame {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0;
    gap: 32px;
    width: 432px;
    height: 187px;
  }

  .subtle {
    width: 150px;
    height: 31px;
    font-family: "Roboto", sans-serif;
    font-style: normal;
    font-weight: 600;
    font-size: 18px;
    line-height: 170%;
    display: flex;
    align-items: center;
    color: #fcfcfc;
    text-transform: uppercase;
  }

  .heading {
    width: 432px;
    height: 124px;
    font-family: "Roboto", sans-serif;
    font-style: normal;
    font-weight: 600;
    font-size: 48px;
    line-height: 130%;
    display: flex;
    align-items: center;
    letter-spacing: -0.03em;
    color: #1b1b1b;
    margin: 0;
  }

  .description {
    width: 432px;
    height: 93px;
    font-family: "Roboto", sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 18px;
    line-height: 170%;
    display: flex;
    align-items: center;
    letter-spacing: -0.02em;
    color: #121212;
    margin: 0;
  }

  /* Info Box */
  .info {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 56px;
    gap: 4px;
    position: absolute;
    width: 533.53px;
    height: 284px;
    left: 120px;
    top: 493px;
    border: 2px solid #000000;
  }

  .frame-23 {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    padding: 0;
    gap: 16px;
    width: 421.53px;
    height: 172px;
  }

  .frame-26 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0;
    gap: 16px;
    width: 227px;
    height: 171px;
  }

  .orlando-fl {
    width: 227px;
    height: 45px;
    font-family: "Roboto", sans-serif;
    font-style: normal;
    font-weight: 600;
    font-size: 32px;
    line-height: 140%;
    display: flex;
    align-items: center;
    letter-spacing: -0.03em;
    color: #000000;
    margin: 0;
  }

  .address {
    width: 227px;
    height: 62px;
    font-family: "Roboto", sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 18px;
    line-height: 170%;
    display: flex;
    align-items: center;
    letter-spacing: -0.02em;
    color: #000000;
    margin: 0;
  }

  .frame-24 {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    padding: 0;
    gap: 8px;
    width: 227px;
    height: 32px;
  }

  .phone-icon {
    width: 32px;
    height: 32px;
  }

  .phone-icon svg {
    width: 100%;
    height: 100%;
  }

  .phone-number {
    width: 127px;
    height: 31px;
    font-family: "Roboto", sans-serif;
    font-style: normal;
    font-weight: 600;
    font-size: 18px;
    line-height: 170%;
    display: flex;
    align-items: center;
    color: #000000;
  }

  /* Orlando Mini Map */
  .orlando-map {
    width: 178.53px;
    height: 172px;
    flex: none;
    order: 1;
  }

  .mini-map-container {
    position: relative;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }

  .map-circle {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    background: transparent;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: filter 0.3s ease;
  }

  .map-circle svg {
    width: 80%;
    height: 80%;
  }

  .mini-map-container:hover .map-circle {
    filter: brightness(0.6);
  }

  .mini-map-overlay {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 8px;
    background: rgba(0, 0, 0, 0);
    transition: background 0.3s ease;
    pointer-events: none;
  }

  .mini-map-container:hover .mini-map-overlay {
    background: rgba(0, 0, 0, 0.45);
  }

  .mini-map-text {
    font-family: "Roboto", sans-serif;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
    color: #ffffff;
    text-align: center;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
    padding: 0 4px;
  }

  .mini-map-container:hover .mini-map-text {
    opacity: 1;
    transform: translateY(0);
  }

  .mini-map-icons {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 8px;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }

  .mini-map-container:hover .mini-map-icons {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .map-nav-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #ffffff;
    color: #1b1b1b;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .map-nav-link:hover {
    transform: scale(1.15);
    background: #e6a523;
    color: #ffffff;
  }

  .map-nav-link svg {
    width: 14px;
    height: 14px;
  }

  /* Button */
  .button-2 {
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 18px 32px;
    gap: 4px;
    isolation: isolate;
    position: absolute;
    width: 234px;
    height: 67px;
    left: 120px;
    top: 809px;
    border: 1px solid #171003;
    border-radius: 7.5px;
    text-decoration: none;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .bg-effect {
    position: absolute;
    width: 0;
    height: 67px;
    left: 0;
    top: 0;
    background: #171003;
    border-radius: 7.5px;
    z-index: 0;
    transition: width 0.3s ease;
  }

  .button-2:hover .bg-effect {
    width: 100%;
  }

  .button-label {
    position: relative;
    z-index: 1;
    font-family: "Roboto", sans-serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 170%;
    color: #2e2107;
    transition: color 0.3s ease;
  }

  .button-2:hover .button-label {
    color: #e6a523;
  }

  /* Responsive Adjustments */
  @media (max-width: 1200px) {
    .services-office {
      height: auto;
      padding: 100px 0;
    }
    .img-map-bg {
      display: none; /* Hide absolute map on smaller screens for better layout */
    }
    .content-wrapper {
      padding: 0 40px;
    }
    .headings,
    .info,
    .button-2 {
      position: relative;
      left: 0;
      top: 0;
      width: 100%;
      height: auto;
      max-width: 533px;
      margin: 0 auto;
    }
    .headings {
      margin-bottom: 48px;
    }
    .info {
      margin-bottom: 32px;
    }
    .container,
    .frame,
    .heading,
    .description,
    .address,
    .orlando-fl {
      width: 100%;
      height: auto;
    }
    .frame-23 {
      flex-direction: column;
      height: auto;
      align-items: flex-start;
      width: 100%;
    }
  }

  @media (max-width: 768px) {
    .content-wrapper {
      padding: 0 20px;
    }
    .heading {
      font-size: 36px;
    }
    .info {
      padding: 32px;
    }
    .orlando-map {
      width: 100%;
      height: 200px;
    }
    .mini-map-text {
      font-size: 16px;
    }
    .map-nav-link {
      width: 36px;
      height: 36px;
    }
    .map-nav-link svg {
      width: 20px;
      height: 20px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const miniMap = document.querySelector('.mini-map-container');
    if (!miniMap) return;

    const googleMapsUrl = "https://maps.google.com/?q=8810+Commodity+Cir+Suite+29+Orlando+FL+32819";

    const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;

    if (isTouchDevice) {
      miniMap.addEventListener('click', (e) => {
        if (e.target.closest('.map-nav-link')) return;
        window.open(googleMapsUrl, '_blank');
      });
    }
  });
</script>
