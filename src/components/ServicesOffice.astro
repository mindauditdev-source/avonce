---
// src/components/ServicesOffice.astro
---

<section class="services-office">
  <div class="img-map-bg"></div>

  <div class="content-wrapper">
    <div class="headings" data-reveal>
      <div class="container">
        <div class="frame">
          <span class="subtle">OFFICE LOCATION</span>
          <h2 class="heading">Local Presence.<br />Regional Reach.</h2>
        </div>
      </div>
      <p class="description">
        Our Orlando office supports multifamily and commercial projects across
        Florida with coordinated planning, field supervision, and end-to-end
        scope delivery.
      </p>
    </div>

    <div class="info" data-reveal data-reveal-delay="200">
      <div class="frame-23">
        <div class="frame-26">
          <h3 class="orlando-fl">Orlando, Fl</h3>
          <p class="address">
            8810 Commodity Cir, Suite 29<br />
            Orlando, Fl 32819
          </p>
          <div class="frame-24">
            <div class="phone-icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M20 15.5C18.8 15.5 17.6 15.3 16.4 14.9C16.1 14.8 15.7 14.9 15.4 15.2L13.2 17.4C10.4 16 8.1 13.7 6.6 10.8L8.8 8.6C9.1 8.3 9.2 7.9 9.1 7.6C8.7 6.4 8.5 5.2 8.5 4C8.5 3.4 8.1 3 7.5 3H4C3.4 3 3 3.4 3 4C3 13.4 10.6 21 20 21C20.6 21 21 20.6 21 20V16.5C21 15.9 20.6 15.5 20 15.5Z"
                  fill="black"></path>
              </svg>
            </div>
            <span class="phone-number">(407) 270-4808</span>
          </div>
        </div>
        <div class="orlando-map">
          <div class="map-circle">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2C8.13 2 5 5.13 5 9C5 14.25 12 22 12 22C12 22 19 14.25 19 9C19 5.13 15.87 2 12 2ZM12 11.5C10.62 11.5 9.5 10.38 9.5 9C9.5 7.62 10.62 6.5 12 6.5C13.38 6.5 14.5 7.62 14.5 9C14.5 10.38 13.38 11.5 12 11.5Z" fill="black"/>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <a href="/contact" class="button-2" data-reveal data-reveal-delay="400">
      <span class="bg-effect"></span>
      <span class="button-label">CONTACT US</span>
    </a>
  </div>
</section>

<style>
  .services-office {
    position: relative;
    width: 100%;
    height: 1024px;
    background: #e6a523;
    overflow: hidden;
  }

  .img-map-bg {
    position: absolute;
    width: 1110px;
    height: 849px;
    left: calc(50% - 1110px / 2 + 113px);
    top: calc(50% - 849px / 2 + 0.5px);
    background: url("/map-stroke.png");
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    opacity: 0.2; /* Subtle stroke visibility */
    pointer-events: none;
    mix-blend-mode: multiply; /* Removes white background and blends stroke with yellow */
  }

  .content-wrapper {
    max-width: 1440px;
    margin: 0 auto;
    position: relative;
    height: 100%;
  }

  /* Headings Section */
  .headings {
    position: absolute;
    width: 432px;
    height: 312px;
    left: 326px;
    top: 149px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
  }

  .container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0;
    gap: 64px;
    width: 432px;
    height: 187px;
  }

  .frame {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0;
    gap: 32px;
    width: 432px;
    height: 187px;
  }

  .subtle {
    width: 150px;
    height: 31px;
    font-family: "Roboto", sans-serif;
    font-style: normal;
    font-weight: 600;
    font-size: 18px;
    line-height: 170%;
    display: flex;
    align-items: center;
    color: #fcfcfc;
    text-transform: uppercase;
  }

  .heading {
    width: 432px;
    height: 124px;
    font-family: "Roboto", sans-serif;
    font-style: normal;
    font-weight: 600;
    font-size: 48px;
    line-height: 130%;
    display: flex;
    align-items: center;
    letter-spacing: -0.03em;
    color: #1b1b1b;
    margin: 0;
  }

  .description {
    width: 432px;
    height: 93px;
    font-family: "Roboto", sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 18px;
    line-height: 170%;
    display: flex;
    align-items: center;
    letter-spacing: -0.02em;
    color: #121212;
    margin: 0;
  }

  /* Info Box */
  .info {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 56px;
    gap: 4px;
    position: absolute;
    width: 533.53px;
    height: 284px;
    left: 326px;
    top: 493px;
    border: 2px solid #000000;
  }

  .frame-23 {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    padding: 0;
    gap: 16px;
    width: 421.53px;
    height: 172px;
  }

  .frame-26 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0;
    gap: 16px;
    width: 227px;
    height: 171px;
  }

  .orlando-fl {
    width: 227px;
    height: 45px;
    font-family: "Roboto", sans-serif;
    font-style: normal;
    font-weight: 600;
    font-size: 32px;
    line-height: 140%;
    display: flex;
    align-items: center;
    letter-spacing: -0.03em;
    color: #000000;
    margin: 0;
  }

  .address {
    width: 227px;
    height: 62px;
    font-family: "Roboto", sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 18px;
    line-height: 170%;
    display: flex;
    align-items: center;
    letter-spacing: -0.02em;
    color: #000000;
    margin: 0;
  }

  .frame-24 {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    padding: 0;
    gap: 8px;
    width: 227px;
    height: 32px;
  }

  .phone-icon {
    width: 32px;
    height: 32px;
  }

  .phone-icon svg {
    width: 100%;
    height: 100%;
  }

  .phone-number {
    width: 127px;
    height: 31px;
    font-family: "Roboto", sans-serif;
    font-style: normal;
    font-weight: 600;
    font-size: 18px;
    line-height: 170%;
    display: flex;
    align-items: center;
    color: #000000;
  }

  /* Orlando Map Circle */
  .orlando-map {
    width: 178.53px;
    height: 172px;
    flex: none;
    order: 1;
  }

  .map-circle {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    background: transparent;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .map-circle svg {
    width: 80%;
    height: 80%;
  }

  /* Button */
  .button-2 {
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 18px 32px;
    gap: 4px;
    isolation: isolate;
    position: absolute;
    width: 234px;
    height: 67px;
    left: 326px;
    top: 809px;
    border: 1px solid #171003;
    border-radius: 7.5px;
    text-decoration: none;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .bg-effect {
    position: absolute;
    width: 0;
    height: 67px;
    left: 0;
    top: 0;
    background: #171003;
    border-radius: 7.5px;
    z-index: 0;
    transition: width 0.3s ease;
  }

  .button-2:hover .bg-effect {
    width: 100%;
  }

  .button-label {
    position: relative;
    z-index: 1;
    font-family: "Roboto", sans-serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 170%;
    color: #2e2107;
    transition: color 0.3s ease;
  }

  .button-2:hover .button-label {
    color: #e6a523;
  }

  /* Responsive Adjustments */
  @media (max-width: 1200px) {
    .services-office {
      height: auto;
      padding: 100px 0;
    }
    .img-map-bg {
      display: none; /* Hide absolute map on smaller screens for better layout */
    }
    .content-wrapper {
      padding: 0 40px;
    }
    .headings,
    .info,
    .button-2 {
      position: relative;
      left: 0;
      top: 0;
      width: 100%;
      height: auto;
      max-width: 533px;
      margin: 0 auto;
    }
    .headings {
      margin-bottom: 48px;
    }
    .info {
      margin-bottom: 32px;
    }
    .container,
    .frame,
    .heading,
    .description,
    .address,
    .orlando-fl {
      width: 100%;
      height: auto;
    }
    .frame-23 {
      flex-direction: column;
      height: auto;
      align-items: flex-start;
      width: 100%;
    }
  }

  @media (max-width: 768px) {
    .content-wrapper {
      padding: 0 20px;
    }
    .heading {
      font-size: 36px;
    }
    .info {
      padding: 32px;
    }
  }
</style>
