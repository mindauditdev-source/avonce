---
// src/components/TeamIntro.astro
---

<section class="team-intro">
  <div class="container">
    <div class="content-block">
      <span class="subtle">OUR TEAM</span>
      <h2 class="heading">A Team Built on Experience,<br />Commitment, and Craft</h2>
      <p class="text">
        At Avonce Construction Group, our success is driven by the people behind the work. From leadership to field crews, our team brings deep experience, strong technical skill, and a shared commitment to quality, safety, and accountability. We work as one, collaborating closely with our clients and partners to plan thoroughly, execute with precision, and deliver projects we can all be proud of. It is this collective dedication - on every site, in every phase - that defines who we are and how we build.
      </p>
    </div>

    <div class="content-block mt-32">
      <h2 class="heading">Leadership & Foundation</h2>
      <div class="text-group">
        <p class="text">
          Avonce Construction Group was founded by Zeferino Avonce, a construction executive with more than three decades of experience in multifamily and commercial development. His leadership is grounded in field expertise, operational discipline, and a deep understanding of the evolving needs of clients and the construction sector.
        </p>
        <p class="text">
          Zeferino's vision goes beyond building structures — it focuses on building value, trust, and long-term partnerships. Through strategic direction and strong execution, he positioned Avonce as a trusted trade partner capable of aligning scope, schedule, and field performance across complex projects in Florida.
        </p>
        <p class="text">
          Driven by accountability and a culture of excellence, his leadership continues to elevate standards, strengthen client relationships, and keep the team aligned, motivated, and focused on delivering results.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .team-intro {
    background: #FCFCFC;
    width: 100%;
    padding: 148px 0; /* from top: 148px in figma */
    display: flex;
    justify-content: center;
    transform: scale(0.96);
    transform-origin: center top;
    will-change: transform;
  }

  .container {
    max-width: 884px; /* from width: 884px in figma */
    width: 100%;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    gap: 64px; /* Space between the two main blocks */
    opacity: 0;
    transform: translateY(4vh);
    will-change: opacity, transform;
  }

  .content-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
  }

  .subtle {
    font-family: 'Roboto', sans-serif;
    font-style: normal;
    font-weight: 600;
    font-size: 18px;
    line-height: 1.7;
    color: #E6A523;
    text-transform: uppercase;
  }

  .heading {
    font-family: 'Roboto', sans-serif;
    font-style: normal;
    font-weight: 600;
    font-size: 48px;
    line-height: 1.3;
    letter-spacing: -0.03em;
    color: #1E1E1E;
    margin: 0;
  }

  .text-group {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .text {
    font-family: 'Roboto', sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.7;
    letter-spacing: -0.02em;
    color: #1B1B1B;
    margin: 0;
  }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .team-intro {
      padding: 80px 0;
    }

    .heading {
      font-size: 36px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const teamIntroSection = document.querySelector('.team-intro') as HTMLElement;
    const container = document.querySelector('.team-intro .container') as HTMLElement;

    if (teamIntroSection && container) {
      let ticking = false;

      function updateAnimation() {
        const rect = teamIntroSection.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        
        let progress = 1 - (rect.top / windowHeight);
        progress = Math.max(0, Math.min(progress, 1));
        
        if (progress >= 1) {
          teamIntroSection.style.transform = 'none';
        } else {
          const scale = 0.96 + (progress * 0.04);
          teamIntroSection.style.transform = `scale(${scale})`;
        }
        
        const opacity = progress; 
        const yOffset = (1 - progress) * 4;
        
        container.style.opacity = opacity.toString();
        container.style.transform = `translateY(${yOffset}vh)`;
        
        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(updateAnimation);
          ticking = true;
        }
      }, { passive: true });

      updateAnimation();
    }
  });
</script>
