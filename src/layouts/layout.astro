---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  navLight?: boolean;
}

const { title, navLight = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Landing Page" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;900&family=Roboto+Slab:wght@500;600&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body
    class="bg-[#121212] text-white selection:bg-[#E6A523] selection:text-black antialiased"
  >
    <Navbar light={navLight} />
    <slot />
    <Footer />
    <style is:global>
      /* Reset base */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      :root {
        --primary: #E6A523;
        --dark: #121212;
      }
      body {
        font-family: 'Roboto', sans-serif;
      }
      h1, h2, h3, h4, h5, h6 {
        font-family: 'Roboto Slab', serif;
      }
    </style>
  </body>
</html>
