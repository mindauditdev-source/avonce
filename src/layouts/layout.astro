---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  navLight?: boolean;
  navPrimary?: boolean;
  hideNav?: boolean;
}

const { title, navLight = false, navPrimary = false, hideNav = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Landing Page" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;900&family=Roboto+Slab:wght@500;600&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body
    class="bg-[#121212] text-white selection:bg-[#E6A523] selection:text-black antialiased"
  >
    {!hideNav && <Navbar light={navLight} primary={navPrimary} />}
    <slot />
    <Footer />
    <style is:global>
      /* Reset base */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      :root {
        --primary: #E6A523;
        --dark: #121212;
      }
      body {
        font-family: 'Roboto', sans-serif;
      }
      h1, h2, h3, h4, h5, h6 {
        font-family: 'Roboto Slab', serif;
      }
    </style>
    <script>
      const revealCallback = (entries: IntersectionObserverEntry[], observer: IntersectionObserver) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      };

      const revealObserver = new IntersectionObserver(revealCallback, {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      });

      const initReveal = () => {
        const revealElements = document.querySelectorAll('[data-reveal]');
        revealElements.forEach(el => revealObserver.observe(el));
      };

      // Handle standard load
      document.addEventListener('DOMContentLoaded', initReveal);
      
      // Handle view transitions / dynamic content
      document.addEventListener('astro:page-load', initReveal);
      
      // Initial run for first page load
      initReveal();
    </script>
  </body>
</html>
