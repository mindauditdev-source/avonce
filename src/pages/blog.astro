---
import Layout from "../layouts/layout.astro";
import BlogHero from "../components/BlogHero.astro";
import BlogFeatured from "../components/BlogFeatured.astro";
import BlogList from "../components/BlogList.astro";
import BlogCTABanners from "../components/BlogCTABanners.astro";
import { getBlogPosts } from "../lib/wordpress";

let posts = [];
try {
  posts = await getBlogPosts();
} catch (error) {
  console.error("Error fetching WordPress posts:", error);
}

const featuredPost = posts[0] || null;
const remainingPosts = posts.slice(1);
---

<Layout title="Avonce - Blog" navLight={true}>
  <main>
    <BlogHero />
    {featuredPost && <BlogFeatured post={featuredPost} />}
    <BlogList posts={posts} />
    <BlogCTABanners />
  </main>
</Layout>
