---
import Layout from "../../layouts/layout.astro";
import { getBlogPosts } from "../../lib/wordpress";

export async function getStaticPaths() {
  let posts = [];
  try {
    posts = await getBlogPosts();
  } catch (error) {
    console.error("Error fetching WordPress posts in getStaticPaths:", error);
  }

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;

// Related posts (all posts except current)
const relatedPosts = (allPosts || [])
  .filter((p) => p.slug !== post.slug)
  .slice(0, 2);
---

<Layout title={`${post.title} — Avonce Blog`} navLight={true}>
  <main class="blog-detail-page">
    <!-- Hero -->
    <section class="post-hero">
      <div
        class="hero-image"
        style={`background-image: linear-gradient(0deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.15) 60%), url('${post.image}');`}
      >
      </div>
      <div class="hero-content">
        <span class="hero-category">{post.category}</span>
        <h1 class="hero-title">{post.title}</h1>
        <div class="hero-meta">
          <span>By {post.author}</span>
          <span class="dot"></span>
          <span>{post.date}</span>
          <span class="dot"></span>
          <span>{post.readTime}</span>
        </div>
      </div>
    </section>

    <!-- Article Body + Sidebar -->
    <section class="post-body-section">
      <div class="post-container">
        <!-- Main Article -->
        <article class="post-article">
          <div class="article-lead">
            <p>{post.excerpt}</p>
          </div>
          <div class="article-divider"></div>
          <div class="article-content" set:html={post.content}></div>

          <!-- Share Row -->
          <div class="share-row">
            <span class="share-label">Share this article:</span>
            <div class="share-links">
              <a
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(
                  "https://avonceconstruction.com/blog/" + post.slug,
                )}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Share on LinkedIn"
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                  ></path>
                  <rect x="2" y="9" width="4" height="12"></rect>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
              </a>
              <a
                href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(
                  post.title,
                )}&url=${encodeURIComponent(
                  "https://avonceconstruction.com/blog/" + post.slug,
                )}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Share on X / Twitter"
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                  ></path>
                </svg>
              </a>
            </div>
          </div>
        </article>

        <!-- Sidebar -->
        <aside class="post-sidebar">
          <!-- Author Card -->
          <div class="author-card">
            <div class="author-avatar">
              {
                post.author
                  .split(" ")
                  .map((n) => n[0])
                  .join("")
              }
            </div>
            <div class="author-info">
              <span class="author-label">Written by</span>
              <span class="author-name">{post.author}</span>
              <span class="author-role">Avonce Team</span>
            </div>
          </div>

          <!-- Back to Blog -->
          <a href="/blog" class="back-link">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M15 18l-6-6 6-6"></path>
            </svg>
            Back to Blog
          </a>
        </aside>
      </div>
    </section>

    <!-- Related Posts -->
    <section class="related-section">
      <div class="related-container">
        <h2 class="related-heading">More Articles</h2>
        <div class="related-grid">
          {
            relatedPosts.map((relatedPost) => {
              return (
                <a href={`/blog/${relatedPost.slug}`} class="related-card">
                  <div
                    class="related-image"
                    style={`background-image: linear-gradient(0deg, rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('${relatedPost.image}');`}
                  >
                    <span class="related-badge">{relatedPost.category}</span>
                  </div>
                  <div class="related-content">
                    <h3>{relatedPost.title}</h3>
                    <span class="related-cta">View More →</span>
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .blog-detail-page {
    background: #fcfcfc;
  }

  /* ── Hero ──────────────────────────────────────────────────── */
  .post-hero {
    position: relative;
    width: 100%;
    min-height: 540px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    z-index: 0;
    transform: scale(1.04);
    transition: transform 0.6s ease;
  }

  .post-hero:hover .hero-image {
    transform: scale(1);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: 0 100px 80px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hero-category {
    font-family: "Roboto", sans-serif;
    font-weight: 600;
    font-size: 14px;
    line-height: 170%;
    text-transform: uppercase;
    color: #e6a523;
    letter-spacing: 0.08em;
  }

  .hero-title {
    font-family: "Roboto", sans-serif;
    font-weight: 700;
    font-size: clamp(28px, 4vw, 52px);
    line-height: 120%;
    letter-spacing: -0.03em;
    color: #ffffff;
    max-width: 780px;
    margin: 0;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-family: "Roboto", sans-serif;
    font-weight: 400;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.75);
  }

  .dot {
    width: 3px;
    height: 3px;
    background: rgba(255, 255, 255, 0.5);
    border-radius: 50%;
  }

  /* ── Body + Sidebar ─────────────────────────────────────────── */
  .post-body-section {
    padding: 80px 0 100px;
    background: #fcfcfc;
  }

  .post-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 100px;
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 80px;
    align-items: start;
  }

  /* Article */
  .post-article {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .article-lead p {
    font-family: "Roboto", sans-serif;
    font-weight: 500;
    font-size: 20px;
    line-height: 170%;
    color: #1b1b1b;
    margin: 0;
  }

  .article-divider {
    width: 60px;
    height: 3px;
    background: #e6a523;
    border-radius: 2px;
  }

  .article-content {
    display: flex;
    flex-direction: column;
    gap: 24px;
    color: #3a3a3a;
  }

  .article-content * {
    color: inherit;
  }

  .article-content p {
    font-family: "Roboto", sans-serif;
    font-weight: 400;
    font-size: 17px;
    line-height: 180%;
    color: #3a3a3a;
    margin: 0;
  }

  .article-content h1,
  .article-content h2,
  .article-content h3,
  .article-content h4,
  .article-content h5,
  .article-content h6 {
    font-family: "Roboto", sans-serif;
    font-weight: 700;
    color: #1b1b1b;
    margin-top: 16px;
    margin-bottom: 8px;
  }

  .article-content h1 { font-size: 32px; }
  .article-content h2 { font-size: 28px; }
  .article-content h3 { font-size: 24px; }
  .article-content h4 { font-size: 20px; }

  .article-content ul,
  .article-content ol {
    margin-left: 24px;
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .article-content ul {
    list-style-type: disc;
  }

  .article-content ol {
    list-style-type: decimal;
  }

  .article-content li {
    font-family: "Roboto", sans-serif;
    font-size: 17px;
    line-height: 160%;
  }

  .article-content blockquote {
    border-left: 4px solid #e6a523;
    padding-left: 16px;
    margin: 16px 0;
    font-style: italic;
    color: #555555;
  }

  /* Share row */
  .share-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid #e5e5e5;
  }

  .share-label {
    font-family: "Roboto", sans-serif;
    font-weight: 600;
    font-size: 13px;
    color: #778189;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .share-links {
    display: flex;
    gap: 12px;
  }

  .share-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid #e5e5e5;
    border-radius: 50%;
    color: #778189;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .share-links a:hover {
    background: #e6a523;
    border-color: #e6a523;
    color: #121212;
  }

  /* Sidebar */
  .post-sidebar {
    display: flex;
    flex-direction: column;
    gap: 32px;
    position: sticky;
    top: 112px;
  }

  .author-card {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 24px;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    background: #ffffff;
  }

  .author-avatar {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #e6a523;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "Roboto", sans-serif;
    font-weight: 700;
    font-size: 18px;
    color: #121212;
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .author-label {
    font-family: "Roboto", sans-serif;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #778189;
  }

  .author-name {
    font-family: "Roboto", sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #1b1b1b;
  }

  .author-role {
    font-family: "Roboto", sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: #778189;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: "Roboto", sans-serif;
    font-weight: 600;
    font-size: 14px;
    color: #1b1b1b;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #e6a523;
  }

  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .sidebar-heading {
    font-family: "Roboto", sans-serif;
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #1b1b1b;
    margin: 0;
  }

  .sidebar-categories {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .sidebar-categories li a {
    display: block;
    padding: 10px 0;
    border-bottom: 1px solid #f0f0f0;
    font-family: "Roboto", sans-serif;
    font-weight: 400;
    font-size: 14px;
    color: #778189;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .sidebar-categories li a:hover {
    color: #e6a523;
  }

  /* ── Related Posts ──────────────────────────────────────────── */
  .related-section {
    background: #121212;
    padding: 80px 0;
  }

  .related-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 100px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .related-heading {
    font-family: "Roboto", sans-serif;
    font-weight: 600;
    font-size: 36px;
    line-height: 130%;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .related-card {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: transform 0.3s ease;
  }

  .related-card:hover {
    transform: translateY(-4px);
  }

  .related-image {
    position: relative;
    width: 100%;
    height: 260px;
    border-radius: 4px;
    background-size: cover;
    background-position: center;
    overflow: hidden;
  }

  .related-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 10px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(6px);
    border-radius: 4px;
    font-family: "Roboto", sans-serif;
    font-weight: 600;
    font-size: 12px;
    color: #ffffff;
  }

  .related-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .related-content h3 {
    font-family: "Roboto", sans-serif;
    font-weight: 600;
    font-size: 17px;
    line-height: 150%;
    color: #ffffff;
    margin: 0;
  }

  .related-cta {
    font-family: "Roboto", sans-serif;
    font-weight: 700;
    font-size: 13px;
    color: #e6a523;
    text-decoration: underline;
  }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media (max-width: 1200px) {
    .hero-content,
    .post-container,
    .related-container {
      padding: 0 60px;
    }
    .post-container {
      grid-template-columns: 1fr 280px;
      gap: 60px;
    }
  }

  @media (max-width: 900px) {
    .hero-content {
      padding: 0 40px 60px;
    }
    .post-body-section {
      padding: 60px 0 80px;
    }
    .post-container {
      padding: 0 40px;
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .post-sidebar {
      position: static;
    }
    .related-container {
      padding: 0 40px;
    }
  }

  @media (max-width: 600px) {
    .post-hero {
      min-height: 420px;
    }
    .hero-content {
      padding: 0 20px 48px;
    }
    .post-container {
      padding: 0 20px;
    }
    .related-container {
      padding: 0 20px;
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
