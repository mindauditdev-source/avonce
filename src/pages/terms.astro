---
import Layout from "../layouts/layout.astro";
---

<Layout title="Terms of Service — Avonce Construction Group" navLight={true}>
  <main class="legal-page">

    <!-- Hero -->
    <section class="legal-hero">
      <div class="legal-hero-inner">
        <p class="eyebrow">Legal</p>
        <h1 class="legal-title">Terms of Service</h1>
        <p class="date-updated">Last Updated: May 14, 2026</p>
      </div>
    </section>

    <!-- Body -->
    <section class="legal-body">
      <div class="legal-container">

        <p class="intro-text">
          By accessing and using the website of Avonce Construction Group, Inc., you agree to be bound by the following terms and conditions.
        </p>

        <!-- Section 01 -->
        <div class="policy-section">
          <p class="section-number">Section 01</p>
          <h2>Scope of Information</h2>
          <ul>
            <li>The content on this website is provided for informational purposes regarding our trade specialty services, including Framing, Interior Finishes, and Exterior Building Systems.</li>
            <li>While we strive for precision and schedule certainty, Avonce Construction Group, Inc. does not guarantee that all information is free of typographical errors or technical inaccuracies.</li>
          </ul>
        </div>

        <!-- Section 02 -->
        <div class="policy-section">
          <p class="section-number">Section 02</p>
          <h2>Intellectual Property Rights</h2>
          <ul>
            <li>All text, logos, branding, and imagery (including photographs in our Project Gallery) are the exclusive property of Avonce Construction Group, Inc.</li>
            <li>Users are prohibited from reproducing, distributing, or modifying any content without prior written consent from our leadership team.</li>
          </ul>
        </div>

        <!-- Section 03 -->
        <div class="policy-section">
          <p class="section-number">Section 03</p>
          <h2>Professional Conduct</h2>
          <ul>
            <li>Any information submitted through our site, particularly for the Join Our Team or Contact sections, must be accurate and truthful.</li>
            <li>We reserve the right to restrict access to the site for any user who engages in unlawful behavior or attempts to compromise the integrity of our digital presence.</li>
          </ul>
        </div>

        <!-- Section 04 -->
        <div class="policy-section">
          <p class="section-number">Section 04</p>
          <h2>Liability Disclaimer</h2>
          <ul>
            <li>To the fullest extent permitted by applicable law, Avonce Construction Group, Inc. shall not be liable for any direct or indirect damages arising from the use or inability to use this website.</li>
            <li>Our commitment to safety and quality on every project site does not extend to third-party links or external websites mentioned for reference.</li>
          </ul>
        </div>

        <!-- Section 05 -->
        <div class="policy-section">
          <p class="section-number">Section 05</p>
          <h2>Compliance and Governing Law</h2>
          <ul>
            <li>These terms are governed by the laws of the State of Florida.</li>
            <li>Any disputes related to these terms shall be subject to the exclusive jurisdiction of the courts in Orlando, FL.</li>
          </ul>
        </div>

        <!-- Section 06 -->
        <div class="policy-section">
          <p class="section-number">Section 06</p>
          <h2>Contact Information</h2>
          <p>If you have any questions regarding these Terms, please reach out to our regional office:</p>
          <address>
            <strong>Avonce Construction Group, Inc.</strong><br />
            8810 Commodity Cir, Suite 29<br />
            Orlando, FL 32819<br />
            <a href="tel:4072704808">(407) 270-4808</a><br />
            <a href="mailto:zef@avonceconstruction.com">zef@avonceconstruction.com</a>
          </address>
        </div>

      </div>
    </section>

  </main>
</Layout>

<style>
  .legal-page {
    background: #fcfcfc;
    min-height: 100vh;
  }

  /* ── Hero ───────────────────────────────────────────────────── */
  .legal-hero {
    background: #121212;
    padding-top: 96px; /* navbar offset */
  }

  .legal-hero-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 80px 100px 72px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .eyebrow {
    font-family: "Roboto", sans-serif;
    font-weight: 600;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #e6a523;
    margin: 0;
  }

  .legal-title {
    font-family: "Roboto", sans-serif;
    font-weight: 700;
    font-size: clamp(36px, 5vw, 64px);
    line-height: 110%;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0;
  }

  .date-updated {
    font-family: "Roboto", sans-serif;
    font-weight: 400;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.45);
    margin: 0;
  }

  /* ── Body ───────────────────────────────────────────────────── */
  .legal-body {
    padding: 80px 0 120px;
  }

  .legal-container {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 100px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Intro */
  .intro-text {
    font-family: "Roboto", sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 180%;
    color: #3a3a3a;
    margin: 0 0 56px;
    padding-bottom: 56px;
    border-bottom: 1px solid #e8e8e8;
  }

  /* Policy Sections */
  .policy-section {
    padding: 48px 0;
    border-bottom: 1px solid #e8e8e8;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .section-number {
    font-family: "Roboto", sans-serif;
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #e6a523;
    margin: 0;
  }

  .policy-section h2 {
    font-family: "Roboto", sans-serif;
    font-weight: 700;
    font-size: 22px;
    line-height: 130%;
    letter-spacing: -0.02em;
    color: #121212;
    margin: 0;
  }

  .policy-section p {
    font-family: "Roboto", sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 175%;
    color: #4a4a4a;
    margin: 0;
  }

  .policy-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .policy-section ul li {
    font-family: "Roboto", sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 175%;
    color: #4a4a4a;
    padding-left: 20px;
    position: relative;
  }

  .policy-section ul li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: #e6a523;
    font-weight: 700;
  }

  /* Address block */
  address {
    font-family: "Roboto", sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 190%;
    color: #4a4a4a;
    padding: 24px 28px;
    border-left: 3px solid #e6a523;
    background: #fafafa;
  }

  address strong {
    color: #121212;
    font-weight: 600;
  }

  address a {
    color: #121212;
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  address a:hover {
    color: #e6a523;
  }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media (max-width: 1200px) {
    .legal-hero-inner,
    .legal-container {
      padding-left: 60px;
      padding-right: 60px;
    }
  }

  @media (max-width: 768px) {
    .legal-hero-inner {
      padding: 60px 40px 48px;
    }
    .legal-container {
      padding: 0 40px;
    }
    .legal-body {
      padding: 60px 0 80px;
    }
  }

  @media (max-width: 480px) {
    .legal-hero-inner {
      padding: 48px 24px 40px;
    }
    .legal-container {
      padding: 0 24px;
    }
    .policy-section h2 {
      font-size: 18px;
    }
  }
</style>
